---
/**
 * Admin shell.
 *
 * Server-rendered guard first (`prerender = false` pages call this): a
 * non-admin never receives admin HTML at all. The visual language is the same
 * square pixel-shadcn used by the public site and the profile island — hairline
 * borders, brand accents, the stepped pixel rule — so the whole product reads
 * as one thing.
 */
import '@/styles/global.css';
import {
  LayoutDashboard,
  Building2,
  Users,
  GraduationCap,
  BadgeCheck,
  Star,
  Flag,
  Image as ImageIcon,
  ChartColumn,
  Settings,
  LogOut,
  Shield,
  ExternalLink,
  Camera,
  HandCoins,
} from '@lucide/astro';
import LogoBadge from '@/components/LogoBadge.astro';
import { currentUser, getDb, isAdmin, publicUser } from '@/lib/server/auth';
import { getAdminInbox } from '@/lib/server/adminInbox';
import NotificationBell from '@/components/admin/NotificationBell.astro';
import type { AdminInboxItem } from '@/lib/adminInbox';

interface Props {
  title?: string;
  description?: string;
  active?:
    | 'dashboard'
    | 'pgs'
    | 'owners'
    | 'students'
    | 'creators'
    | 'verification'
    | 'payments'
    | 'experiences'
    | 'reports'
    | 'content'
    | 'analytics'
    | 'settings';
}

const { title = 'Admin — PG Hunter', description = 'PG Hunter admin control room.', active = 'dashboard' } = Astro.props;

// Server-side admin guard: never trust the client. This runs per request
// because every admin page sets `prerender = false`.
const user = await currentUser(Astro as any);
const isAuthedAdmin = Boolean(user && isAdmin(user));

if (!user) {
  Astro.response.status = 401;
} else if (!isAuthedAdmin) {
  Astro.response.status = 403;
}

// Derived notification feed (never fabricated): real queue rows + this admin's
// last-seen watermark. A missing table degrades to an empty inbox.
let inboxItems: AdminInboxItem[] = [];
let inboxUnread = 0;
if (user && isAuthedAdmin) {
  try {
    const inbox = await getAdminInbox(getDb(), user.id);
    inboxItems = inbox.items;
    inboxUnread = inbox.unread;
  } catch {
    inboxItems = [];
    inboxUnread = 0;
  }
}

const adminAvatar = user ? publicUser(user).avatar : null;
const initials = (user?.name ?? 'AD')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');

const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin', Icon: LayoutDashboard },
  { key: 'pgs', label: 'Listings', href: '/admin/pgs', Icon: Building2 },
  { key: 'owners', label: 'Owners', href: '/admin/owners', Icon: Users },
  { key: 'students', label: 'Students', href: '/admin/students', Icon: GraduationCap },
  { key: 'creators', label: 'Creators', href: '/admin/creators', Icon: Camera },
  { key: 'verification', label: 'Verification', href: '/admin/verification', Icon: BadgeCheck },
  { key: 'payments', label: 'Payments', href: '/admin/payments', Icon: HandCoins },
  { key: 'experiences', label: 'Experiences', href: '/admin/experiences', Icon: Star },
  { key: 'reports', label: 'Reports', href: '/admin/reports', Icon: Flag },
  { key: 'content', label: 'Content', href: '/admin/content', Icon: ImageIcon },
  { key: 'analytics', label: 'Analytics', href: '/admin/analytics', Icon: ChartColumn },
  { key: 'settings', label: 'Settings', href: '/admin/settings', Icon: Settings },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#7a42e6" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    {
      isAuthedAdmin ? (
        <div class="flex min-h-screen">
          {/* Desktop sidebar */}
          <aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white lg:flex lg:flex-col">
            <div class="flex h-16 items-center gap-2 border-b border-slate-100 px-5">
              <LogoBadge class="h-7 w-7" />
              <span class="text-sm font-extrabold tracking-tight text-slate-900">
                PG<span class="text-brand-600">Hunter</span>
                <span class="ml-1.5 rounded-sm bg-brand-600 px-1.5 py-0.5 text-[10px] font-bold tracking-wide text-white uppercase">
                  Admin
                </span>
              </span>
            </div>

            <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Admin">
              <div class="flex flex-col gap-1">
                {nav.map((item) => (
                  <a
                    href={item.href}
                    data-hover-lift
                    class:list={[
                      'flex min-h-11 items-center gap-2.5 rounded-sm px-3 text-sm font-semibold transition-colors',
                      active === item.key
                        ? 'bg-brand-600 text-white'
                        : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
                    ]}
                    aria-current={active === item.key ? 'page' : undefined}
                  >
                    <item.Icon class="h-4 w-4 shrink-0" /> {item.label}
                  </a>
                ))}
              </div>
            </nav>

            <div class="border-t border-slate-100 p-4">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-sm bg-brand-600 text-xs font-extrabold text-white">
                  {adminAvatar ? (
                    <img
                      src={adminAvatar}
                      alt=""
                      class="h-full w-full object-cover"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <span>{initials}</span>
                  )}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-slate-900">{user?.name ?? 'Admin'}</p>
                  <p class="truncate text-xs text-slate-500">{user?.email ?? ''}</p>
                </div>
              </div>
              <div class="mt-3 flex items-center gap-2">
                <a
                  href="/"
                  class="flex min-h-10 flex-1 items-center justify-center gap-1.5 rounded-sm border border-slate-200 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
                >
                  <ExternalLink class="h-4 w-4" /> Site
                </a>
                <button
                  data-logout
                  class="flex min-h-10 flex-1 items-center justify-center gap-1.5 rounded-sm border border-slate-200 text-sm font-semibold text-slate-700 transition-colors hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600"
                >
                  <LogOut class="h-4 w-4" /> Log out
                </button>
              </div>
            </div>
          </aside>

          <div class="flex min-w-0 flex-1 flex-col">
            {/* Mobile header */}
            <header class="sticky top-0 z-30 border-b border-slate-200 bg-white lg:hidden">
              <div class="flex h-16 items-center gap-3 px-4">
                <LogoBadge class="h-7 w-7" />
                <span class="flex items-center gap-1.5 text-sm font-extrabold">
                  PG<span class="text-brand-600">Hunter</span>
                  <span class="rounded-sm bg-brand-600 px-1.5 py-0.5 text-[10px] text-white">ADMIN</span>
                </span>
                <span class="ml-auto flex items-center gap-2 text-xs font-semibold text-slate-500">
                  <Shield class="h-4 w-4 text-brand-600" />
                  {user?.name?.split(' ')[0] ?? 'Admin'}
                </span>
                <NotificationBell unread={inboxUnread} items={inboxItems} />
              </div>
              <nav class="flex gap-1.5 overflow-x-auto px-3 pb-3" aria-label="Admin">
                {nav.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      'inline-flex min-h-10 shrink-0 items-center gap-1.5 rounded-sm px-3 text-sm font-semibold',
                      active === item.key
                        ? 'bg-brand-600 text-white'
                        : 'border border-slate-200 bg-white text-slate-600',
                    ]}
                  >
                    <item.Icon class="h-4 w-4" /> {item.label}
                  </a>
                ))}
              </nav>
            </header>

            {/* Desktop top bar */}
            <div class="hidden items-center justify-between border-b border-slate-200 bg-white px-6 py-3 lg:flex">
              <p class="text-sm font-semibold text-slate-500">
                Admin control room · <span class="text-slate-900">{nav.find((n) => n.key === active)?.label}</span>
              </p>
              <div class="flex items-center gap-3">
                <p class="text-xs text-slate-400">Signed in as {user?.email ?? ''}</p>
                <NotificationBell unread={inboxUnread} items={inboxItems} />
              </div>
            </div>

            <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <div class="mx-auto max-w-lg px-6 py-24 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center bg-rose-100 text-rose-700">
            <Shield class="h-6 w-6" />
          </div>
          <p class="eyebrow mt-6 justify-center">Admin only</p>
          <div class="pixel-rule mt-3 justify-center" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          <h1 class="mt-5 text-2xl font-extrabold text-slate-900">Access denied</h1>
          <p class="mt-2 text-sm text-slate-600">
            You need admin access to view this page. If you are an admin, make sure your email
            is in <code class="rounded bg-slate-100 px-1 py-0.5">ADMIN_EMAILS</code> and sign in again.
          </p>
          <a href="/login?next=/admin" class="btn-primary mt-6">Go to login</a>
        </div>
      )
    }

    <script>
      import { signOut } from '@/lib/auth';
      import { bootMotionUI } from '@/lib/motion/ui';

      bootMotionUI();

      document.querySelectorAll('[data-logout]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          await signOut();
          window.location.href = '/login';
        });
      });
    </script>
  </body>
</html>
