---
import PublicHeader from '@/components/PublicHeader.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Emit <meta name="robots" content="noindex"> (e.g. auth callback pages). */
  noindex?: boolean;
}

const {
  title = 'PG Hunter — Find PGs, Rooms & Student Flats Near Your College',
  description =
    'PG Hunter helps students discover PGs, rooms, hostels and co-living spaces near their college with video walkthroughs, transparent pricing and verified listings. No broker, no hidden charges.',
  image = '/og-default.svg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PG Hunter" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#7a42e6" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />

    {/*
      Entrances are hidden by CSS (see global.css) only once we know JS will
      run them, so nothing flashes in before Motion hydrates. The failsafe
      clears the class if the animation module never arrives — a page must
      never be left blank because a chunk failed to load.
    */}
    <script is:inline>
      // Entrances are CSS scroll-driven where supported (see global.css), so
      // the hidden state is only needed for the JS fallback. Adding the class
      // unconditionally would leave content stuck at opacity 0 in exactly the
      // engines that already handle it natively.
      if (
        !window.CSS ||
        !CSS.supports('animation-timeline', 'view()')
      ) {
        document.documentElement.classList.add('js-motion');
        // If the motion module never arrives, nothing may stay hidden.
        window.__pgMotionFailsafe = setTimeout(function () {
          document.documentElement.classList.remove('js-motion');
        }, 2500);
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <PublicHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { bootMotionUI } from '@/lib/motion/ui';
  bootMotionUI();
</script>
