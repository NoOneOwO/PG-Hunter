---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import PropertyCard from '@/components/PropertyCard.astro';
import {
  ArrowRight,
  SlidersHorizontal,
  ArrowUpDown,
  Building2,
  Video,
  Mic,
  BadgeCheck,
  ShieldCheck,
} from '@lucide/astro';

import { colleges } from '@/data/colleges';
import { activeProperties } from '@/data/properties';

const popular = activeProperties();
const totalPgs = popular.length;

// The headline is split server-side so each word can stagger in with a CSS
// blur-rise — no React island on the hero (see .hero-word in global.css).
const heroWords = 'PG tera bhai dilaega 💪'.split(' ');

// The four proof points, kept as a compact trust line inside the hero rather
// than as a block of feature cards between the hero and the listings.
const valueProps = [
  { Icon: Video, label: 'Video walkthroughs' },
  { Icon: Mic, label: 'Owner interviews' },
  { Icon: BadgeCheck, label: 'Verified listings' },
  { Icon: ShieldCheck, label: 'Safety first' },
];
---

<BaseLayout>
  <!-- ============================================================ hero -->
  <section class="relative isolate overflow-hidden bg-slate-950">
  <!--
    Real photograph, not an illustration. Covering the whole hero and pushed to
    the back so the compact copy + search sit on top of it.
  -->
  <img
    src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1920&q=75"
    alt=""
    width="1920"
    height="1280"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <!-- Readability wash: darker on the left where the copy lives, clearing to
       the right so the room still reads as a room. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950/90 via-slate-950/75 to-slate-950/40"
  ></div>

  <div class="mx-auto max-w-7xl px-4 pt-9 pb-8 sm:px-6 sm:pt-12 sm:pb-10 lg:px-8 lg:pt-14 lg:pb-12">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold tracking-[0.18em] text-white/70 uppercase">
        Student housing, minus the broker
      </p>
      <h1
        class="mt-3 flex flex-wrap gap-x-[0.28em] text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        {heroWords.map((word, i) => (
          <span class="hero-word" style={`--i:${i}`}>
            {word === '💪' ? <span class="align-middle">💪</span> : word}
          </span>
        ))}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/80 sm:text-base">
        ₹0 brokerage. Real video walkthroughs before you pay. Find a PG, room or
        co-living space near your college — and actually see it first.
      </p>

      <ul class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-white/90">
        {
          valueProps.map(({ Icon, label }) => (
            <li class="inline-flex items-center gap-1.5">
              <Icon class="h-4 w-4 text-accent-300" aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Search is the primary action: front and centre, not buried below. -->
    <div class="mt-6 lg:mt-8">
      <SearchPanel />
    </div>
  </div>
</section>

<!-- ==================================================== popular PGs -->
<section aria-labelledby="popular-heading" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="eyebrow">Popular right now</span>
      <div class="pixel-rule mt-2.5" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h2 id="popular-heading" class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        Popular PGs near you
      </h2>
      <p class="mt-1 text-sm font-medium text-slate-500">
        {totalPgs} PGs found near your college
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a
        href="/pgs-near-you"
        class="inline-flex min-h-11 items-center gap-1.5 border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-300"
      >
        <SlidersHorizontal class="h-4 w-4" />
        Filters
      </a>
      <a
        href="/pgs-near-you"
        class="inline-flex min-h-11 items-center gap-1.5 border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-300"
      >
        <ArrowUpDown class="h-4 w-4" />
        Sort
      </a>
    </div>
  </div>

  <div data-reveal-group class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {popular.map((p) => (
      <PropertyCard property={p} />
    ))}
  </div>

  <div class="mt-8 flex justify-center">
    <a href="/pgs-near-you" class="btn-primary px-8">
      View all PGs
      <ArrowRight class="h-4 w-4" />
    </a>
  </div>
</section>

<!-- ------------------------------------------------ live rail -->
<section id="live-section" aria-labelledby="live-heading" class="hidden border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Live right now</span>
        <div class="pixel-rule mt-2.5" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <h2 id="live-heading" class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
          Fresh from owners
        </h2>
        <p class="mt-1 text-sm font-medium text-slate-500">
          Approved listings taking enquiries today — these are real, not samples.
        </p>
      </div>
      <a
        href="/pgs-near-you"
        class="inline-flex min-h-11 items-center gap-1.5 border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-300"
      >
        See every live PG
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>

    <div id="live-grid" class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
  </div>
</section>

<!-- ------------------------------------------------ college grid -->
<section aria-labelledby="colleges-heading" class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <span class="eyebrow">Start where you study</span>
    <div class="pixel-rule mt-2.5" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <h2 id="colleges-heading" class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
      Explore by college
    </h2>
    <p class="mt-1 text-sm font-medium text-slate-500">
      Start with your campus and we'll find what's close.
    </p>

    <div data-reveal-group class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        colleges.map((c) => (
          <a
            href={`/colleges/${c.slug}`}
            class="card card-hover flex items-center gap-4 p-4"
            data-hover-lift
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center bg-brand-100 text-brand-700">
              <Building2 class="h-5 w-5" />
            </span>
            <span>
              <span class="block text-sm font-bold text-slate-900">{c.shortName}</span>
              <span class="block text-xs text-slate-500">
                {c.locality} · {c.city}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- --------------------------------------------------- owner CTA -->
<section aria-labelledby="owners-heading">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="pixel-corner relative flex flex-col items-start gap-6 overflow-hidden border border-brand-700 bg-brand-600 p-8 text-white lg:flex-row lg:items-center lg:justify-between lg:p-10">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold tracking-[0.18em] text-brand-200 uppercase">
          For property owners
        </span>
        <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <h2 id="owners-heading" class="mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl">
          Fill your empty beds, not your time.
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-brand-100 sm:text-base">
          List your PG or rooms and receive enquiries from verified students near your
          property. You stay in control of availability, pricing and your own listing.
        </p>
      </div>
      <a href="/for-owners" class="btn-accent shrink-0 px-8">
        For Owners
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
</BaseLayout>

<script>
  // The live rail is filled from D1 after load. The section stays hidden until
  // something real arrives, so the home page never shows an empty promise.
  import { fetchLiveListings, renderLiveCards, wireLiveSaveButtons } from '@/lib/liveListings';

  const liveSection = document.getElementById('live-section');
  const liveGrid = document.getElementById('live-grid');

  if (liveSection && liveGrid) {
    void (async () => {
      const listings = await fetchLiveListings({ limit: 3 });
      if (listings.length === 0) return;
      renderLiveCards(liveGrid, listings);
      liveSection.classList.remove('hidden');
      await wireLiveSaveButtons(liveGrid);
    })();
  }
</script>