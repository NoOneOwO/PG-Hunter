---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LogoBadge from '@/components/LogoBadge.astro';
import {
  Mail,
  Lock,
  ArrowRight,
  UserRound,
  GraduationCap,
  Building2,
  ShieldCheck,
  TriangleAlert,
} from '@lucide/astro';

const googleMark = `<svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82Z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24Z"/><path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29A11.86 11.86 0 0 0 0 12c0 1.94.47 3.76 1.29 5.38l3.98-3.09Z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75Z"/></svg>`;
---

<BaseLayout
  title="Login / Sign up — PG Hunter"
  description="Log in or create a free account on PG Hunter to save PGs, send enquiries and message owners."
>
  <section class="mx-auto max-w-md px-4 py-10 sm:px-6">
    <!-- Step 1 — choose how you will use PG Hunter.
         Server-rendered visible so the question is the first thing anyone
         sees; the script swaps in the auth card when ?role= is present. -->
    <div id="role-step">
      <div class="card pixel-corner relative p-8">
        <LogoBadge class="h-10 w-10" alt="PG Hunter" />
        <div class="pixel-rule mt-5" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900">
          How will you use PG Hunter?
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Pick the account that fits. You can switch later.
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <a
            id="role-student"
            href="/login?role=student"
            class="group flex items-start gap-3 rounded-sm border border-slate-200 p-4 transition-colors hover:border-brand-500 hover:bg-brand-50/60"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm bg-brand-50 text-brand-700 group-hover:bg-brand-100">
              <GraduationCap class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center justify-between gap-2">
                <span class="text-base font-bold text-slate-900">I'm a Student</span>
                <ArrowRight class="h-4 w-4 shrink-0 text-slate-400 transition-colors group-hover:text-brand-600" />
              </span>
              <span class="mt-0.5 block text-sm leading-relaxed text-slate-500">
                Find PGs, save listings, explore accommodation, and join the PG Hunter creator program.
              </span>
            </span>
          </a>

          <a
            id="role-owner"
            href="/login?role=owner"
            class="group flex items-start gap-3 rounded-sm border border-slate-200 p-4 transition-colors hover:border-brand-500 hover:bg-brand-50/60"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm bg-brand-50 text-brand-700 group-hover:bg-brand-100">
              <Building2 class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center justify-between gap-2">
                <span class="text-base font-bold text-slate-900">I'm a PG Owner</span>
                <ArrowRight class="h-4 w-4 shrink-0 text-slate-400 transition-colors group-hover:text-brand-600" />
              </span>
              <span class="mt-0.5 block text-sm leading-relaxed text-slate-500">
                List and manage properties, reach students, and manage listing plans.
              </span>
            </span>
          </a>
        </div>

        <p class="mt-5 text-center text-xs text-slate-500">
          Already have an account? Pick the account type you signed up with, then log in.
        </p>
      </div>
    </div>

    <!-- Step 2 — log in or sign up as the chosen account type. -->
    <div id="auth-step" class="hidden">
      <div class="card pixel-corner relative p-8">
        <div class="flex items-center justify-between gap-3">
          <LogoBadge class="h-10 w-10" alt="PG Hunter" />
          <a
            id="role-change"
            href="/login"
            class="inline-flex items-center gap-1.5 rounded-sm border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-50"
          >
            <ShieldCheck class="h-3.5 w-3.5 text-brand-600" />
            <span id="role-change-label">Student</span>
            <span class="text-slate-400">· Change</span>
          </a>
        </div>
        <div class="pixel-rule mt-5" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <h1 id="auth-title" class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900">
          Welcome back
        </h1>
        <p id="auth-subtitle" class="mt-1 text-sm text-slate-500">
          Log in to save PGs, send enquiries and message owners.
        </p>

        <!-- Role mismatch: the account that authenticated is a different type
             than the door the user came through. Explain, never escalate. -->
        <div
          id="role-mismatch"
          class="mt-4 hidden rounded-sm border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
          role="alert"
        >
          <p class="flex items-center gap-2 font-semibold">
            <TriangleAlert class="h-4 w-4 shrink-0" />
            <span id="mismatch-title">Different account type</span>
          </p>
          <p id="mismatch-detail" class="mt-1 leading-relaxed"></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button id="mismatch-continue" type="button" class="btn-primary min-h-10 px-4 text-xs">
              Continue
            </button>
            <a href="/login" id="mismatch-back" class="btn-secondary min-h-10 px-4 text-xs">
              Choose a different account
            </a>
          </div>
        </div>

        <div id="auth-error" class="mt-4 hidden rounded-sm border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-sm font-medium text-rose-700" role="alert"></div>
        <div id="auth-success" class="mt-4 hidden rounded-sm border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-sm font-medium text-emerald-700" role="status"></div>

        <!-- Google is the primary, server-side OAuth — presented first per Phase 2 -->
        <button id="google-btn" type="button" class="btn-secondary mt-6 w-full">
          <Fragment set:html={googleMark} />
          Continue with Google
        </button>
        <p class="mt-2 text-center text-xs text-slate-500">Works for both students and owners. New accounts respect your selected role.</p>

        <div class="my-6 flex items-center gap-3 text-xs font-medium tracking-[0.18em] text-slate-400 uppercase">
          <span class="h-px flex-1 bg-slate-200" aria-hidden="true"></span>
          or
          <span class="h-px flex-1 bg-slate-200" aria-hidden="true"></span>
        </div>

        <div class="grid grid-cols-2 gap-px border border-slate-200 bg-slate-200" role="tablist" aria-label="Account access">
          <button
            id="tab-login"
            type="button"
            role="tab"
            aria-selected="true"
            data-tab="login"
            class="bg-white py-2.5 text-sm font-semibold text-slate-900 transition-colors"
          >
            Log in
          </button>
          <button
            id="tab-signup"
            type="button"
            role="tab"
            aria-selected="false"
            data-tab="signup"
            class="py-2.5 text-sm font-semibold text-slate-500 transition-colors"
          >
            Sign up free
          </button>
        </div>

        <form id="login-form" class="mt-6 flex flex-col gap-4">
          <label class="field">
            <Mail class="h-5 w-5 shrink-0 text-brand-600" />
            <span class="sr-only">Email</span>
            <input
              type="email"
              name="email"
              placeholder="Email address"
              autocomplete="email"
              class="w-full bg-transparent outline-none"
              required
            />
          </label>
          <label class="field">
            <Lock class="h-5 w-5 shrink-0 text-brand-600" />
            <span class="sr-only">Password</span>
            <input
              type="password"
              name="password"
              placeholder="Password"
              autocomplete="current-password"
              class="w-full bg-transparent outline-none"
              required
            />
          </label>
          <button type="submit" class="btn-primary w-full">
            Login
            <ArrowRight class="h-4 w-4" />
          </button>
        </form>

        <form id="signup-form" class="mt-6 hidden flex flex-col gap-4">
          <label class="field">
            <UserRound class="h-5 w-5 shrink-0 text-brand-600" />
            <span class="sr-only">Full name</span>
            <input
              type="text"
              name="name"
              placeholder="Full name"
              autocomplete="name"
              class="w-full bg-transparent outline-none"
              required
            />
          </label>
          <label class="field">
            <Mail class="h-5 w-5 shrink-0 text-brand-600" />
            <span class="sr-only">Email</span>
            <input
              type="email"
              name="email"
              placeholder="Email address"
              autocomplete="email"
              class="w-full bg-transparent outline-none"
              required
            />
          </label>
          <label class="field">
            <Lock class="h-5 w-5 shrink-0 text-brand-600" />
            <span class="sr-only">Password</span>
            <input
              type="password"
              name="password"
              placeholder="Create a password (min 6 characters)"
              autocomplete="new-password"
              class="w-full bg-transparent outline-none"
              minlength="6"
              required
            />
          </label>
          <div class="mt-1 grid grid-cols-2 gap-2" role="radiogroup" aria-label="Account type">
            <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-sm border border-slate-200 px-3.5 text-sm font-semibold text-slate-700 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-700">
              <input type="radio" name="role" value="student" class="sr-only" checked />
              <GraduationCap class="h-4 w-4" />
              Student
            </label>
            <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-sm border border-slate-200 px-3.5 text-sm font-semibold text-slate-700 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-700">
              <input type="radio" name="role" value="owner" class="sr-only" />
              <Building2 class="h-4 w-4" />
              Owner
            </label>
          </div>
          <button type="submit" class="btn-primary w-full">
            Create free account
            <ArrowRight class="h-4 w-4" />
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-500">
          <span id="switch-hint">Don't have an account?</span>{' '}
          <a href="#switch" id="switch-link" class="font-semibold text-brand-700 hover:underline">Sign up free</a>
        </p>
        <p class="mt-3 rounded-sm border border-slate-200 bg-slate-50 px-3 py-2.5 text-center text-xs text-slate-500">
          Your account and shortlist are stored securely on Cloudflare.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    getSession,
    login,
    register,
    signInWithGoogle,
    onAuthChange,
  } from '@/lib/auth';
  import { isRoleMismatch, roleLabel, selectableRole, type UserRole } from '@/lib/roles';

  const params = new URLSearchParams(window.location.search);
  const next = params.get('next') ?? '/';
  const safeNext = next.startsWith('/') && !next.startsWith('//') ? next : '/';

  // The role the visitor chose on step 1. Anything that is not exactly
  // `student`/`owner` (including a crafted `?role=admin`) is treated as "not
  // chosen", so the selector is shown again rather than trusting the value.
  const selectedRole = selectableRole(params.get('role'));

  // ?mode=signup opens the sign-up tab directly.
  const requestedMode = params.get('mode');

  // ?ref=CODE is a Campus Creator's share link. It is reduced to the referral
  // alphabet here so nothing unexpected travels in the body; the API validates
  // it again and only credits an approved creator.
  const creatorRef = (params.get('ref') ?? '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 16);

  const roleStep = document.getElementById('role-step') as HTMLElement;
  const authStep = document.getElementById('auth-step') as HTMLElement;
  const roleStudent = document.getElementById('role-student') as HTMLAnchorElement;
  const roleOwner = document.getElementById('role-owner') as HTMLAnchorElement;
  const roleChange = document.getElementById('role-change') as HTMLAnchorElement;
  const roleChangeLabel = document.getElementById('role-change-label') as HTMLElement;
  const mismatch = document.getElementById('role-mismatch') as HTMLElement;
  const mismatchTitle = document.getElementById('mismatch-title') as HTMLElement;
  const mismatchDetail = document.getElementById('mismatch-detail') as HTMLElement;
  const mismatchContinue = document.getElementById('mismatch-continue') as HTMLButtonElement;
  const tabLogin = document.getElementById('tab-login') as HTMLButtonElement;
  const tabSignup = document.getElementById('tab-signup') as HTMLButtonElement;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const signupForm = document.getElementById('signup-form') as HTMLFormElement;
  const title = document.getElementById('auth-title') as HTMLElement;
  const subtitle = document.getElementById('auth-subtitle') as HTMLElement;
  const errorEl = document.getElementById('auth-error') as HTMLElement;
  const successEl = document.getElementById('auth-success') as HTMLElement;
  const switchLink = document.getElementById('switch-link') as HTMLAnchorElement;
  const switchHint = document.getElementById('switch-hint') as HTMLElement;
  const googleBtn = document.getElementById('google-btn') as HTMLButtonElement;
  const loginSubmit = loginForm.querySelector('button[type="submit"]') as HTMLButtonElement;
  const signupSubmit = signupForm.querySelector('button[type="submit"]') as HTMLButtonElement;

  /**
   * Rebuild the current /login URL with a different query, keeping every other
   * parameter (next, mode, ref) intact so switching role never loses the
   * destination the visitor came for.
   */
  const loginHref = (overrides: Record<string, string | null>): string => {
    const p = new URLSearchParams(params);
    for (const [key, value] of Object.entries(overrides)) {
      if (value === null) p.delete(key);
      else p.set(key, value);
    }
    const qs = p.toString();
    return `/login${qs ? `?${qs}` : ''}`;
  };

  const showError = (message: string) => {
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    successEl.classList.add('hidden');
  };

  const showSuccess = (message: string) => {
    successEl.textContent = message;
    successEl.classList.remove('hidden');
    errorEl.classList.add('hidden');
  };

  const clearMessages = () => {
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');
    mismatch.classList.add('hidden');
  };

  const setMode = (mode: 'login' | 'signup') => {
    const isSignup = mode === 'signup';
    title.textContent = isSignup ? 'Create your account' : 'Welcome back';
    subtitle.textContent = isSignup
      ? 'Free forever. Save PGs, send enquiries and manage your listings.'
      : 'Log in to save PGs, send enquiries and message owners.';
    loginForm.classList.toggle('hidden', isSignup);
    signupForm.classList.toggle('hidden', !isSignup);
    tabLogin.setAttribute('aria-selected', String(!isSignup));
    tabSignup.setAttribute('aria-selected', String(isSignup));
    tabLogin.classList.toggle('bg-white', !isSignup);
    tabLogin.classList.toggle('text-slate-900', !isSignup);
    tabLogin.classList.toggle('text-slate-500', isSignup);
    tabSignup.classList.toggle('bg-white', isSignup);
    tabSignup.classList.toggle('text-slate-900', isSignup);
    tabSignup.classList.toggle('text-slate-500', !isSignup);
    switchLink.textContent = isSignup ? 'Log in' : 'Sign up free';
    switchHint.textContent = isSignup ? 'Already have an account?' : "Don't have an account?";
    clearMessages();
  };

  tabLogin.addEventListener('click', () => setMode('login'));
  tabSignup.addEventListener('click', () => setMode('signup'));
  switchLink.addEventListener('click', (e) => {
    e.preventDefault();
    setMode(tabSignup.getAttribute('aria-selected') === 'true' ? 'login' : 'signup');
  });

  // Step 1 vs step 2. The role cards are real links so the flow also works if
  // the script above never runs.
  roleStudent.href = loginHref({ role: 'student' });
  roleOwner.href = loginHref({ role: 'owner' });
  roleChange.href = loginHref({ role: null });

  const setRoleRadio = (role: UserRole) => {
    const radio = signupForm.querySelector<HTMLInputElement>(`input[name="role"][value="${role}"]`);
    if (radio) radio.checked = true;
  };

  if (selectedRole) {
    roleStep.classList.add('hidden');
    authStep.classList.remove('hidden');
    roleChangeLabel.textContent = roleLabel(selectedRole);
    setRoleRadio(selectedRole);
    // Owners arriving from the acquisition flow land on sign-up (preserving the
    // previous behaviour); everyone else starts on log in.
    const initialMode = requestedMode === 'signup' || selectedRole === 'owner' ? 'signup' : 'login';
    setMode(initialMode);
  }

  // Server-side redirects can land here with an error, e.g. Google not configured.
  const urlError = params.get('error');
  if (urlError === 'google-not-configured') {
    showError('Google sign-in is not set up yet. Use email/password, or add your Google credentials (see CLOUDFLARE_SETUP.md).');
  } else if (urlError === 'google-denied') {
    showError('Google sign-in was cancelled.');
  } else if (urlError === 'google-redirect-mismatch') {
    showError(
      'Google rejected the sign-in because this app’s callback address is not registered ' +
        'with the OAuth client. Add the exact redirect URI from CLOUDFLARE_SETUP.md §2 to ' +
        '“Authorized redirect URIs”, on a Web application client.'
    );
  } else if (urlError === 'google-failed') {
    showError('Could not complete Google sign-in. Please try again.');
  }

  /**
   * The authenticated account is a different type than the selected door.
   * Explain it and offer the correct next step. This never changes a role:
   * the session already carries whatever the server stored.
   */
  const showMismatch = (actualRole: UserRole) => {
    clearMessages();
    mismatch.classList.remove('hidden');
    if (actualRole === 'owner') {
      mismatchTitle.textContent = 'This is a PG Owner account';
      mismatchDetail.textContent =
        'You selected Student, but these credentials belong to a PG Owner account. ' +
        'You can continue to your owner dashboard.';
      mismatchContinue.textContent = 'Continue to owner dashboard';
      mismatchContinue.dataset.target = '/owner';
    } else {
      mismatchTitle.textContent = 'This is a Student account';
      mismatchDetail.textContent =
        'You selected PG Owner, but these credentials belong to a Student account. ' +
        'Continue as a student, or go back and sign up for an owner account.';
      mismatchContinue.textContent = 'Continue as a student';
      mismatchContinue.dataset.target = safeNext;
    }
    mismatch.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  mismatchContinue.addEventListener('click', () => {
    window.location.href = mismatchContinue.dataset.target || safeNext;
  });

  const finish = () => {
    window.location.href = safeNext;
  };

  /** After any successful sign-in, reconcile the selected door with the account. */
  const afterAuth = (user: { role: UserRole; isAdmin?: boolean } | null | undefined) => {
    if (!user) return false;
    if (isRoleMismatch(selectedRole, user.role, Boolean(user.isAdmin))) {
      showMismatch(user.role);
      return true;
    }
    finish();
    return true;
  };

  // Already signed in? Go straight to the destination.
  getSession().then((user) => {
    if (user) finish();
  });

  // OAuth mismatch: the Worker bounced an existing account back here.
  if (urlError === 'role-mismatch') {
    showMismatch('student');
  }

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();
    loginSubmit.disabled = true;
    loginSubmit.textContent = 'Logging in...';
    const data = new FormData(loginForm);
    const { user, error } = await login({
      email: String(data.get('email') ?? ''),
      password: String(data.get('password') ?? ''),
    });
    loginSubmit.disabled = false;
    loginSubmit.innerHTML = 'Login <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
    if (error) return showError(error);
    afterAuth(user);
  });

  signupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();
    signupSubmit.disabled = true;
    signupSubmit.textContent = 'Creating account...';
    const data = new FormData(signupForm);
    const { user, needsConfirmation, error } = await register({
      name: String(data.get('name') ?? ''),
      email: String(data.get('email') ?? ''),
      password: String(data.get('password') ?? ''),
      // The chosen role drives the default, but the radio in the form is the
      // final word. The server accepts only student/owner regardless.
      role: (data.get('role') as UserRole) ?? selectedRole ?? 'student',
      ref: creatorRef || undefined,
    });
    signupSubmit.disabled = false;
    signupSubmit.innerHTML = 'Create free account <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
    if (error) return showError(error);
    if (needsConfirmation) {
      showSuccess('Almost there — check your inbox and click the confirmation link to activate your account.');
      return;
    }
    if (user) {
      showSuccess(`Account created — welcome, ${user.name.split(' ')[0]}!`);
      setTimeout(finish, 600);
    }
  });

  googleBtn.addEventListener('click', async () => {
    clearMessages();
    const original = googleBtn.innerHTML;
    googleBtn.disabled = true;
    googleBtn.textContent = 'Redirecting to Google…';
    const { error } = await signInWithGoogle(safeNext, selectedRole ?? undefined);
    if (error) {
      googleBtn.disabled = false;
      googleBtn.innerHTML = original;
      showError(error);
    }
  });

  // If OAuth completes back on this page (rather than the callback), finish here.
  onAuthChange((user) => {
    if (user) afterAuth(user);
  });
</script>
