---
// Prices come from the `plans` table (migration 0008), not from this file, so a
// price change is an admin/data change rather than a code change.
export const prerender = false;
import OwnerLayout from '@/layouts/OwnerLayout.astro';
import { BadgeCheck, Sparkles, ArrowRight, Building2, Check } from '@lucide/astro';
import { getPlans } from '@/lib/server/plans';
import { resolvePlan } from '@/lib/plans';
import { formatINR } from '@/lib/format';

const plans = await getPlans();
const basic = resolvePlan(plans, 'basic');
const verified = resolvePlan(plans, 'verified');
---

<OwnerLayout title="Choose a Plan — PG Hunter" active="listings">
  <div class="mx-auto max-w-4xl">
    <div class="text-center">
      <span class="badge bg-brand-100 text-brand-800">
        <Building2 class="h-3.5 w-3.5" /> For Owners
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Choose how you list
      </h1>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base">
        Both plans get you live on PG Hunter. Pick Basic to list free, or go
        Verified to stand out and win more student trust.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <!-- Basic -->
      <article class="card flex flex-col p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-extrabold text-slate-900">{basic.name}</h2>
          <span class="badge bg-slate-100 text-slate-600">{basic.priceInr === 0 ? 'Free' : 'Paid'}</span>
        </div>
        <p class="mt-1 text-sm text-slate-500">{basic.tagline}</p>
        <p class="mt-5 text-3xl font-extrabold text-slate-900">
          {formatINR(basic.priceInr)}
          <span class="text-sm font-medium text-slate-400">/ {basic.durationLabel}</span>
        </p>
        <ul class="mt-6 flex-1 space-y-3 text-sm text-slate-700">
          {basic.features.map((feature) => (
            <li class="flex items-start gap-2"><Check class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" /> {feature}</li>
          ))}
        </ul>
        <a href="/owner/listings/new" class="btn-secondary mt-8 w-full">
          Continue with Basic
          <ArrowRight class="h-4 w-4" />
        </a>
      </article>

      <!-- Verified -->
      <article class="card relative flex flex-col overflow-hidden p-6 ring-2 ring-brand-600">
        <span class="absolute right-0 top-0 rounded-bl-xl bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
          Most trusted
        </span>
        <div class="flex items-center justify-between">
          <h2 class="flex items-center gap-2 text-lg font-extrabold text-slate-900">
            <BadgeCheck class="h-5 w-5 text-brand-600" /> {verified.name}
          </h2>
          <span class="badge bg-brand-100 text-brand-800">{verified.priceInr === 0 ? 'Free' : 'Paid'}</span>
        </div>
        <p class="mt-1 text-sm text-slate-500">{verified.tagline}</p>
        <p class="mt-5 text-3xl font-extrabold text-slate-900">
          {formatINR(verified.priceInr)}
          <span class="text-sm font-medium text-slate-400">
            {verified.hasTravelCharge ? '+ travel' : ''} / {verified.durationLabel}
          </span>
        </p>
        <ul class="mt-6 flex-1 space-y-3 text-sm text-slate-700">
          {verified.features.map((feature) => (
            <li class="flex items-start gap-2"><Sparkles class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" /> {feature}</li>
          ))}
        </ul>
        <a href="/owner/plans/verified" class="btn-primary mt-8 w-full">
          Choose Verified
          <ArrowRight class="h-4 w-4" />
        </a>
      </article>
    </div>

    <p class="mt-8 rounded-xl bg-brand-50 px-4 py-3 text-center text-sm font-medium text-brand-800">
      Not sure yet? Start with Basic for free — you can upgrade to Verified anytime.
    </p>
  </div>
</OwnerLayout>