---
import OwnerLayout from '@/layouts/OwnerLayout.astro';
import { CloudUpload, CircleCheck } from '@lucide/astro';
---

<OwnerLayout title="Verification — PG Hunter" active="verification">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Verification</h1>
    <p class="mt-1 text-sm font-medium text-slate-500">
      Upload documents to get your PGs verified by the PG Hunter team.
    </p>
  </div>

  <div id="verification-loading" class="mx-auto max-w-md py-20 text-center" role="status">
    <span class="mx-auto flex h-12 w-12 animate-spin items-center justify-center rounded-full border-4 border-brand-100 border-t-brand-600"></span>
    <p class="mt-4 text-sm font-medium text-slate-500">Loading verification status…</p>
  </div>

  <div id="verification-root" class="hidden">
    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <section class="card lg:col-span-1" aria-labelledby="status-heading">
        <div class="border-b border-slate-100 px-5 py-4">
          <h2 id="status-heading" class="text-base font-bold text-slate-900">Current status</h2>
        </div>
        <div class="p-5">
          <span id="verification-badge" class="badge bg-slate-100 text-slate-600">Loading…</span>
          <p id="verification-note" class="mt-3 text-sm leading-relaxed text-slate-600"></p>
          <ul class="mt-4 space-y-2 text-sm">
            <li class="flex items-center gap-2 text-slate-700">
              <CircleCheck class="h-4 w-4 text-emerald-600" /> Identity document
            </li>
            <li class="flex items-center gap-2 text-slate-700">
              <CircleCheck class="h-4 w-4 text-emerald-600" /> Property ownership / agreement
            </li>
          </ul>
        </div>
      </section>

      <section class="card lg:col-span-2" aria-labelledby="upload-heading">
        <div class="border-b border-slate-100 px-5 py-4">
          <h2 id="upload-heading" class="text-base font-bold text-slate-900">Upload verification documents</h2>
        </div>
        <div class="p-5">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="verify-listing" class="mb-1.5 block text-sm font-semibold text-slate-700">Linked PG (optional)</label>
              <select id="verify-listing" class="field w-full appearance-none">
                <option value="">— Attach to a PG —</option>
              </select>
            </div>
            <div>
              <label for="verify-type" class="mb-1.5 block text-sm font-semibold text-slate-700">Document type</label>
              <select id="verify-type" class="field w-full appearance-none">
                <option value="identity">Identity proof</option>
                <option value="ownership">Ownership / agreement</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <label class="mt-4 flex min-h-32 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-500 transition-colors hover:border-brand-400 hover:bg-brand-50 hover:text-brand-700">
            <CloudUpload class="h-6 w-6" />
            <span class="text-sm font-semibold">Upload document</span>
            <span class="text-xs">PDF / JPEG / PNG / WebP, up to 10 MB</span>
            <input id="verify-file" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" class="sr-only" />
          </label>
          <p id="verify-status" class="mt-3 hidden text-sm font-medium text-emerald-700" role="status"></p>
        </div>
      </section>
    </div>

    <section class="card mt-6" aria-labelledby="docs-heading">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 id="docs-heading" class="text-base font-bold text-slate-900">Submitted documents</h2>
      </div>
      <div id="docs-list" class="divide-y divide-slate-100"></div>
    </section>
  </div>
</OwnerLayout>

<script>
  import { getVerificationState, getOwnerListings, uploadFile } from '@/lib/auth';
  import { formatShortDate } from '@/lib/owner';

  const loading = document.getElementById('verification-loading')!;
  const root = document.getElementById('verification-root')!;
  const badge = document.getElementById('verification-badge')!;
  const note = document.getElementById('verification-note')!;
  const listingSelect = document.getElementById('verify-listing') as HTMLSelectElement;
  const typeSelect = document.getElementById('verify-type') as HTMLSelectElement;
  const fileInput = document.getElementById('verify-file') as HTMLInputElement;
  const statusEl = document.getElementById('verify-status')!;
  const docsList = document.getElementById('docs-list')!;

  const docStatusBadge = (status: string) =>
    status === 'approved'
      ? '<span class="badge bg-emerald-100 text-emerald-800">Approved</span>'
      : status === 'rejected'
        ? '<span class="badge bg-rose-100 text-rose-800">Rejected</span>'
        : '<span class="badge bg-amber-100 text-amber-800">Pending</span>';

  const renderDocs = (docs: { id: string; docType: string; fileName: string; status: string; notes: string | null; createdAt: string }[]) => {
    docsList.innerHTML = docs.length
      ? docs.map((d) => `
        <div class="flex items-center gap-4 px-5 py-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-bold text-slate-900">${d.fileName}</p>
            <p class="text-xs font-medium capitalize text-slate-500">${d.docType} · ${formatShortDate(d.createdAt)}</p>
            ${d.notes ? `<p class="mt-1 text-xs font-medium text-rose-600">${d.notes}</p>` : ''}
          </div>
          ${docStatusBadge(d.status)}
        </div>`)
        .join('')
      : '<p class="px-5 py-8 text-center text-sm font-semibold text-slate-500">No documents submitted yet.</p>';
  };

  const init = async () => {
    const [verification, { listings }] = await Promise.all([getVerificationState(), getOwnerListings()]);

    listingSelect.innerHTML =
      '<option value="">— Attach to a PG —</option>' +
      listings.map((l) => `<option value="${l.id}">${l.name}</option>`).join('');

    const statusMeta: Record<string, { label: string; classes: string; note: string }> = {
      approved: { label: 'Verified', classes: 'bg-emerald-100 text-emerald-800', note: 'Your documents are approved. Your PG carries a PG Hunter Verified badge.' },
      pending: { label: 'Pending review', classes: 'bg-amber-100 text-amber-800', note: 'Your documents are with our team for review. We usually respond within a few days.' },
      none: { label: 'Not started', classes: 'bg-slate-100 text-slate-600', note: 'Upload your identity proof and ownership/agreement documents to get verified.' },
    };
    const meta = statusMeta[verification.status];
    badge.className = `badge ${meta.classes}`;
    badge.textContent = meta.label;
    note.textContent = meta.note;

    renderDocs(verification.documents);

    loading.classList.add('hidden');
    root.classList.remove('hidden');
  };

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    statusEl.className = 'mt-3 text-sm font-medium text-slate-500';
    statusEl.textContent = 'Uploading…';
    statusEl.classList.remove('hidden');
    try {
      const listingId = listingSelect.value || undefined;
      const docType = typeSelect.value;
      await uploadFile('verification', file, { listingId, docType });
      statusEl.className = 'mt-3 text-sm font-medium text-emerald-700';
      statusEl.textContent = 'Document uploaded for review.';
      const fresh = await getVerificationState();
      renderDocs(fresh.documents);
      fileInput.value = '';
    } catch (err) {
      statusEl.className = 'mt-3 text-sm font-medium text-rose-700';
      statusEl.textContent = `Upload failed: ${(err as Error).message}`;
    }
  });

  void init();
</script>
