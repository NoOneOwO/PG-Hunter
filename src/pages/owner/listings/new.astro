---
import OwnerLayout from '@/layouts/OwnerLayout.astro';
import ListingForm from '@/components/owner/ListingForm.astro';
import { ArrowLeft } from '@lucide/astro';
---

<OwnerLayout title="Add PG — PG Hunter" active="listings">
  <div data-reveal>
    <a href="/owner/listings" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-500 hover:text-brand-700">
      <ArrowLeft class="h-4 w-4" /> Back to My PGs
    </a>
    <p class="eyebrow mt-4">Owner workspace</p>
    <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Add a PG</h1>
    <p class="mt-1 text-sm font-medium text-slate-500">
      Fill in the basics, save as a draft, then add photos and submit for review.
    </p>
  </div>
  <div class="mt-6 max-w-4xl" data-reveal>
    <ListingForm mode="create" />
  </div>
</OwnerLayout>
