---
import OwnerLayout from '@/layouts/OwnerLayout.astro';
import ListingForm from '@/components/owner/ListingForm.astro';
import { ArrowLeft } from '@lucide/astro';

export const prerender = false;

const { id } = Astro.params;
---

<OwnerLayout title="Edit PG — PG Hunter" active="listings">
  <a href="/owner/listings" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-500 hover:text-brand-700">
    <ArrowLeft class="h-4 w-4" /> Back to My PGs
  </a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 id="edit-title" class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Edit listing</h1>
    <div id="edit-badges" class="flex items-center gap-2"></div>
  </div>

  <div id="edit-loading" class="mx-auto max-w-md py-20 text-center" role="status">
    <span class="mx-auto flex h-12 w-12 animate-spin items-center justify-center rounded-full border-4 border-brand-100 border-t-brand-600"></span>
    <p class="mt-4 text-sm font-medium text-slate-500">Loading listing…</p>
  </div>

  <div id="edit-error" class="card mt-6 hidden max-w-4xl p-6 text-sm font-semibold text-rose-700" role="alert"></div>

  <div id="edit-root" class="hidden">
    <div class="mt-6 max-w-4xl">
      <ListingForm mode="edit" listingId={id!} />
    </div>
  </div>
</OwnerLayout>

<script>
  import { getOwnerListing } from '@/lib/auth';
  import { listingStatusMeta, verificationStatusMeta } from '@/lib/owner';

  const id = new URLSearchParams(window.location.search).get('id') ??
    window.location.pathname.split('/').filter(Boolean).slice(-1)[0];

  const loading = document.getElementById('edit-loading')!;
  const root = document.getElementById('edit-root')!;
  const errorEl = document.getElementById('edit-error')!;
  const titleEl = document.getElementById('edit-title')!;
  const badgesEl = document.getElementById('edit-badges')!;

  const badge = (classes: string, label: string) =>
    `<span class="badge ${classes}">${label}</span>`;

  const init = async () => {
    try {
      const { listing } = await getOwnerListing(id);
      titleEl.textContent = listing.name;
      const status = listingStatusMeta[listing.status];
      const verification = verificationStatusMeta[listing.verificationStatus];
      badgesEl.innerHTML =
        badge(status.classes, status.label) +
        badge(verification.classes, verification.label) +
        (listing.status === 'active'
          ? `<a href="/pgs/${listing.name}" class="inline-flex min-h-9 items-center gap-1 rounded-full bg-brand-50 px-3 text-xs font-semibold text-brand-700 hover:bg-brand-100" title="View public listing">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              View
            </a>`
          : '');
      root.classList.remove('hidden');
    } catch (err) {
      errorEl.textContent = (err as Error).message;
      errorEl.classList.remove('hidden');
    } finally {
      loading.classList.add('hidden');
    }
  };
  void init();
</script>

