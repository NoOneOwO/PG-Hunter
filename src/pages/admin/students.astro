---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';
import { Search, GraduationCap, Bookmark, Star, MessageCircle } from '@lucide/astro';

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.trim() ?? '';
const db = getDb();

const students = await db
  .prepare(
    `SELECT u.id, u.name, u.email, u.avatar_url, u.provider, u.created_at,
            (SELECT COUNT(*) FROM saved_pgs s WHERE s.user_id = u.id) as saves,
            (SELECT COUNT(*) FROM pg_experiences e WHERE e.user_id = u.id) as exps,
            (SELECT COUNT(*) FROM leads l WHERE l.student_id = u.id) as enqs
     FROM users u
     WHERE u.role = 'student' ${q ? 'AND (u.name LIKE ? OR u.email LIKE ?)' : ''}
     ORDER BY u.created_at DESC LIMIT 100`
  )
  .bind(...(q ? [`%${q}%`, `%${q}%`] : []))
  .all();

const rows = students.results as any[];

const initials = (name: string) =>
  (name ?? '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? '')
    .join('') || 'S';

/** Mirrors server `avatarUrl()` semantics for R2 keys vs absolute URLs. */
const avatarFor = (v: string | null): string | null => {
  if (!v) return null;
  if (/^https?:\/\//i.test(v)) return v;
  return v.startsWith('/') ? v : `/api/media/${v}`;
};

const totals = rows.reduce(
  (acc, s) => ({ saves: acc.saves + Number(s.saves ?? 0), exps: acc.exps + Number(s.exps ?? 0), enqs: acc.enqs + Number(s.enqs ?? 0) }),
  { saves: 0, exps: 0, enqs: 0 }
);

const statCards = [
  { label: 'Students shown', value: rows.length, hint: q ? `Filtered by “${q}”` : 'Most recent 100', Icon: GraduationCap },
  { label: 'Saved PGs', value: totals.saves, hint: 'Across shown students', Icon: Bookmark },
  { label: 'Experiences', value: totals.exps, hint: 'Written by shown students', Icon: Star },
  { label: 'Enquiries', value: totals.enqs, hint: 'Sent to owners', Icon: MessageCircle },
];
---

<AdminLayout title="Students — Admin" active="students">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">People</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Students</h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Read-only directory — what students save, write and enquire about. Never shows password material.
      </p>
    </div>
    <span class="badge border border-slate-200 bg-white px-3 py-2 text-slate-600">{rows.length} shown</span>
  </div>

  <div data-reveal-group class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      statCards.map((card) => (
        <div class="card p-5" data-hover-lift>
          <span class="flex h-10 w-10 items-center justify-center bg-brand-50 text-brand-700">
            <card.Icon class="h-5 w-5" />
          </span>
          <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900" data-count-up={card.value}>
            {card.value}
          </p>
          <p class="text-sm font-semibold text-slate-500">{card.label}</p>
          <p class="mt-0.5 text-xs text-slate-400">{card.hint}</p>
        </div>
      ))
    }
  </div>

  <form class="mt-6 flex flex-wrap items-center gap-2" data-reveal>
    <label class="field w-full sm:w-80">
      <Search class="h-4 w-4 shrink-0 text-slate-400" />
      <span class="sr-only">Search students</span>
      <input name="q" value={q} placeholder="Search name or email" class="w-full bg-transparent text-sm outline-none" />
    </label>
    <button class="btn-primary px-5">Search</button>
    <a href="/admin/students" class="btn-secondary px-5">Clear</a>
  </form>

  {
    rows.length === 0 ? (
      <div class="card pixel-corner relative mt-8 px-6 py-14 text-center">
        <div class="pixel-rule justify-center" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <p class="mt-5 text-base font-bold text-slate-900">{q ? 'No students match that search' : 'No students yet'}</p>
        <p class="mt-1 text-sm text-slate-500">Students appear here the moment they sign up.</p>
      </div>
    ) : (
      <div class="card mt-6 overflow-x-auto" data-reveal>
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold tracking-wide text-slate-500 uppercase">
            <tr>
              <th class="px-4 py-3">Student</th>
              <th class="px-4 py-3">Email</th>
              <th class="px-4 py-3">Joined</th>
              <th class="px-4 py-3 text-center">Saves</th>
              <th class="px-4 py-3 text-center">Experiences</th>
              <th class="px-4 py-3 text-center">Enquiries</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {rows.map((s) => {
              const avatar = avatarFor(s.avatar_url ?? null);
              return (
                <tr class="transition-colors hover:bg-brand-50/40">
                  <td class="px-4 py-3">
                    <span class="flex items-center gap-3">
                      {avatar ? (
                        <img src={avatar} alt="" width="32" height="32" class="h-8 w-8 shrink-0 border border-slate-200 object-cover" loading="lazy" />
                      ) : (
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center bg-brand-50 text-xs font-extrabold text-brand-700">
                          {initials(s.name)}
                        </span>
                      )}
                      <span class="flex flex-col">
                        <span class="font-semibold text-slate-900">{s.name}</span>
                        <span class="text-xs text-slate-400">{s.provider === 'google' ? 'Google account' : 'Email account'}</span>
                      </span>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-xs text-slate-500">{s.email}</td>
                  <td class="px-4 py-3 text-xs text-slate-500">
                    {new Date(s.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </td>
                  <td class="px-4 py-3 text-center font-extrabold text-slate-900">{s.saves}</td>
                  <td class="px-4 py-3 text-center font-extrabold text-slate-900">{s.exps}</td>
                  <td class="px-4 py-3 text-center font-extrabold text-slate-900">{s.enqs}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }

  <script>
    import { bootMotionUI } from '@/lib/motion/ui';
    import { initCountUps } from '@/lib/countUp';
    bootMotionUI();
    initCountUps();
  </script>
</AdminLayout>
