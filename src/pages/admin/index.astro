---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';
import { revenueSummary } from '@/lib/server/payments';
import { ShieldCheck, Users, Building2, Eye, Heart, ThumbsUp, ThumbsDown, ArrowRight, Clock } from '@lucide/astro';

const db = getDb();

// Platform
const [usersRes, listingsRes, leadsRes, verifsRes, expsRes, reportsRes, engRes, mediaRes] = await Promise.all([
  db.prepare(`SELECT role, COUNT(*) as n FROM users GROUP BY role`).all<{ role: string; n: number }>(),
  db.prepare(`SELECT status, COUNT(*) as n FROM owner_listings GROUP BY status`).all<{ status: string; n: number }>(),
  db
    .prepare(`SELECT COUNT(*) as n FROM leads`)
    .first<{ n: number }>()
    .catch(() => ({ n: 0 })),
  db
    .prepare(`SELECT status, COUNT(*) as n FROM verification_documents GROUP BY status`)
    .all<{ status: string; n: number }>()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(`SELECT status, COUNT(*) as n FROM pg_experiences GROUP BY status`)
    .all<{ status: string; n: number }>()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(`SELECT status, COUNT(*) as n FROM reports GROUP BY status`)
    .all<{ status: string; n: number }>()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(`SELECT event_type, COUNT(*) as n FROM pg_engagement_events GROUP BY event_type`)
    .all<{ event_type: string; n: number }>()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(`SELECT COUNT(*) as n FROM media`)
    .first<{ n: number }>()
    .catch(() => ({ n: 0 })),
]);

const byKey = (rows: any[], key: string) =>
  rows.find((r: any) => r.role === key || r.status === key || r.event_type === key)?.n ?? 0;
const totalUsers = usersRes.results.reduce((a: any, c: any) => a + c.n, 0);
const totalListings = listingsRes.results.reduce((a: any, c: any) => a + c.n, 0);
const pendingExps = byKey(expsRes.results, 'pending');
const pendingVerifs = byKey(verifsRes.results, 'pending');
const pendingReports = byKey(reportsRes.results, 'open');

const revenue = await revenueSummary(db);

const eng = (t: string) => byKey(engRes.results, t);
const totalViews = eng('VIEW');
const totalSaves = eng('SAVE');
const totalLikes = eng('LIKE');
const totalDislikes = eng('DISLIKE');

// Recent activity
const [recentExps, recentVerifs, recentReports, recentListings, recentLeads] = await Promise.all([
  db
    .prepare(
      `SELECT e.*, u.name as user_name FROM pg_experiences e LEFT JOIN users u ON u.id=e.user_id ORDER BY e.created_at DESC LIMIT 5`
    )
    .all()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(
      `SELECT d.*, u.name as owner_name FROM verification_documents d LEFT JOIN users u ON u.id=d.owner_id ORDER BY d.created_at DESC LIMIT 5`
    )
    .all()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(
      `SELECT r.*, u.name as reporter_name FROM reports r LEFT JOIN users u ON u.id=r.reporter_id ORDER BY r.created_at DESC LIMIT 5`
    )
    .all()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(
      `SELECT ol.*, u.name as owner_name FROM owner_listings ol LEFT JOIN users u ON u.id=ol.owner_id ORDER BY ol.created_at DESC LIMIT 5`
    )
    .all()
    .catch(() => ({ results: [] } as any)),
  db
    .prepare(
      `SELECT l.*, u.name as student_name FROM leads l LEFT JOIN users u ON u.id=l.student_id ORDER BY l.created_at DESC LIMIT 5`
    )
    .all()
    .catch(() => ({ results: [] } as any)),
]);

const attention = [
  { label: 'Experiences awaiting review', value: pendingExps, href: '/admin/experiences', tone: 'amber' },
  { label: 'Verification documents', value: pendingVerifs, href: '/admin/verification', tone: 'amber' },
  { label: 'Open reports', value: pendingReports, href: '/admin/reports', tone: 'rose' },
  { label: 'Listings awaiting approval', value: byKey(listingsRes.results, 'pending'), href: '/admin/pgs?status=pending', tone: 'amber' },
  { label: 'Payments to confirm', value: revenue.pendingCount, href: '/admin/payments', tone: 'amber' },
];
const attentionTotal = attention.reduce((sum, item) => sum + item.value, 0);

const statCards = [
  { label: 'Total users', value: totalUsers, hint: `Students ${byKey(usersRes.results, 'student')} · Owners ${byKey(usersRes.results, 'owner')}`, Icon: Users },
  { label: 'Listings (D1)', value: totalListings, hint: `Live ${byKey(listingsRes.results, 'active')} · Pending ${byKey(listingsRes.results, 'pending')}`, Icon: Building2 },
  { label: 'Enquiries', value: leadsRes?.n ?? 0, hint: 'Leads captured from students', Icon: ArrowRight },
  { label: 'Media objects', value: mediaRes?.n ?? 0, hint: 'Photos, docs and embeds', Icon: Eye },
];

const engCards = [
  { label: 'Views', value: totalViews, Icon: Eye },
  { label: 'Saves', value: totalSaves, Icon: Heart },
  { label: 'Likes', value: totalLikes, Icon: ThumbsUp },
  { label: 'Dislikes', value: totalDislikes, Icon: ThumbsDown },
];
---

<AdminLayout title="Admin Dashboard — PG Hunter" active="dashboard">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Control room</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Dashboard</h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Real numbers from D1 — no placeholders. Empty states say so instead of inventing data.
      </p>
    </div>
    {
      attentionTotal > 0 ? (
        <a href="#attention" class="badge border border-amber-300 bg-amber-100 px-3 py-2 text-amber-900">
          <Clock class="h-3.5 w-3.5" /> {attentionTotal} item{attentionTotal === 1 ? '' : 's'} need{attentionTotal === 1 ? 's' : ''} attention
        </a>
      ) : (
        <span class="badge border border-emerald-200 bg-emerald-50 px-3 py-2 text-emerald-800">
          <ShieldCheck class="h-3.5 w-3.5" /> Queues clear
        </span>
      )
    }
  </div>

  {/* Primary stats */}
  <div data-reveal-group class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      statCards.map((card) => (
        <div class="card p-5" data-hover-lift>
          <span class="flex h-10 w-10 items-center justify-center bg-brand-50 text-brand-700">
            <card.Icon class="h-5 w-5" />
          </span>
          <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900" data-count-up={card.value}>
            {card.value}
          </p>
          <p class="text-sm font-semibold text-slate-500">{card.label}</p>
          <p class="mt-0.5 text-xs text-slate-400">{card.hint}</p>
        </div>
      ))
    }
  </div>

  {/* Attention queue */}
  <section id="attention" class="mt-8" aria-labelledby="attention-heading">
    <h2 id="attention-heading" class="section-head text-lg font-bold text-slate-900">Needs a human</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        attention.map((item) => (
          <a
            href={item.href}
            class:list={[
              'card flex items-center justify-between gap-3 p-4 transition-colors',
              item.value > 0 ? 'border-amber-300 hover:border-amber-400' : 'hover:border-brand-300',
            ]}
            data-reveal
          >
            <span class="text-sm font-semibold text-slate-700">{item.label}</span>
            <span class:list={['badge text-sm font-extrabold', item.value > 0 ? 'bg-amber-100 text-amber-900' : 'bg-emerald-100 text-emerald-800']}>
              {item.value}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {/* Engagement */}
  <section class="mt-8" aria-labelledby="engagement-heading">
    <h2 id="engagement-heading" class="section-head text-lg font-bold text-slate-900">Engagement</h2>
    <div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        engCards.map((card) => (
          <div class="card p-5" data-reveal>
            <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase">
              <card.Icon class="h-4 w-4" /> {card.label}
            </p>
            <p class="mt-2 text-xl font-extrabold text-slate-900" data-count-up={card.value}>{card.value}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Recent activity */}
  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="card" aria-labelledby="recent-exp-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="recent-exp-heading" class="text-sm font-bold text-slate-900">Recent experiences</h2>
        <a href="/admin/experiences" class="text-xs font-semibold text-brand-700 hover:underline">Moderate</a>
      </div>
      <div class="divide-y divide-slate-100">
        {
          recentExps.results.length === 0 ? (
            <p class="p-5 text-sm text-slate-500">No experiences yet.</p>
          ) : (
            recentExps.results.map((r: any) => (
              <div class="px-5 py-3">
                <p class="truncate text-sm font-semibold text-slate-800">{r.content?.slice(0, 70) ?? '—'}</p>
                <p class="text-xs text-slate-500">
                  {r.user_name ?? '—'} · {r.status} · {new Date(r.created_at).toLocaleDateString('en-IN')}
                </p>
              </div>
            ))
          )
        }
      </div>
    </section>

    <section class="card" aria-labelledby="recent-leads-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="recent-leads-heading" class="text-sm font-bold text-slate-900">Recent enquiries</h2>
        <a href="/admin/pgs" class="text-xs font-semibold text-brand-700 hover:underline">Listings</a>
      </div>
      <div class="divide-y divide-slate-100">
        {
          recentLeads.results.length === 0 ? (
            <p class="p-5 text-sm text-slate-500">No enquiries yet.</p>
          ) : (
            recentLeads.results.map((r: any) => (
              <div class="px-5 py-3">
                <p class="truncate text-sm font-semibold text-slate-800">{r.message ?? 'Enquiry'}</p>
                <p class="text-xs text-slate-500">
                  {r.student_name ?? 'Student'} · {r.budget ?? 'budget n/a'} ·{' '}
                  {new Date(r.created_at).toLocaleDateString('en-IN')}
                </p>
              </div>
            ))
          )
        }
      </div>
    </section>

    <section class="card" aria-labelledby="recent-verif-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="recent-verif-heading" class="text-sm font-bold text-slate-900">Recent verification documents</h2>
        <a href="/admin/verification" class="text-xs font-semibold text-brand-700 hover:underline">Review</a>
      </div>
      <div class="divide-y divide-slate-100">
        {
          recentVerifs.results.length === 0 ? (
            <p class="p-5 text-sm text-slate-500">No documents yet.</p>
          ) : (
            recentVerifs.results.map((r: any) => (
              <div class="px-5 py-3">
                <p class="text-sm font-semibold text-slate-800">
                  {r.doc_type} · {r.status}
                </p>
                <p class="text-xs text-slate-500">
                  {r.owner_name ?? '—'} · {new Date(r.created_at).toLocaleDateString('en-IN')}
                </p>
              </div>
            ))
          )
        }
      </div>
    </section>

    <section class="card" aria-labelledby="recent-reports-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="recent-reports-heading" class="text-sm font-bold text-slate-900">Recent reports</h2>
        <a href="/admin/reports" class="text-xs font-semibold text-brand-700 hover:underline">Resolve</a>
      </div>
      <div class="divide-y divide-slate-100">
        {
          recentReports.results.length === 0 ? (
            <p class="p-5 text-sm text-slate-500">No reports — the good outcome.</p>
          ) : (
            recentReports.results.map((r: any) => (
              <div class="px-5 py-3">
                <p class="text-sm font-semibold text-slate-800">
                  {r.target_type} · {r.reason}
                </p>
                <p class="text-xs text-slate-500">
                  {r.status} · {new Date(r.created_at).toLocaleDateString('en-IN')}
                </p>
              </div>
            ))
          )
        }
      </div>
    </section>

    <section class="card lg:col-span-2" aria-labelledby="recent-pgs-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="recent-pgs-heading" class="text-sm font-bold text-slate-900">Newest listings</h2>
        <a href="/admin/pgs" class="text-xs font-semibold text-brand-700 hover:underline">Moderate</a>
      </div>
      <div class="divide-y divide-slate-100">
        {
          recentListings.results.length === 0 ? (
            <p class="p-5 text-sm text-slate-500">
              No owner listings yet — they appear here the moment an owner creates one.
            </p>
          ) : (
            recentListings.results.map((r: any) => (
              <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-3">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-slate-800">{r.name}</p>
                  <p class="text-xs text-slate-500">
                    {r.owner_name ?? '—'} · {r.locality}, {r.city}
                  </p>
                </div>
                <span class="badge bg-slate-100 text-slate-600">{r.status}</span>
              </div>
            ))
          )
        }
      </div>
    </section>
  </div>

  <script>
    import { initCountUps } from '@/lib/countUp';
    import { bootMotionUI } from '@/lib/motion/ui';

    bootMotionUI();
    initCountUps();
  </script>
</AdminLayout>
