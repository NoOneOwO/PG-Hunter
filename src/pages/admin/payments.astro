---
/**
 * Plan payments — admin confirmation queue.
 *
 * Server-rendered like the other admin queues. There is no gateway: an owner
 * submits a UPI reference and an admin confirms the money actually arrived.
 * Confirming opens the paid plan window; verification (the badge) is a separate
 * ledger and is never granted by a payment.
 */
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';
import {
  countPaymentsByStatus,
  listPaymentsForAdmin,
  revenueSummary,
} from '@/lib/server/payments';
import { paymentStatusMeta, type PaymentStatus } from '@/lib/payments';
import { formatINR } from '@/lib/format';
import { Check, X, HandCoins, Clock3, TrendingUp, CircleCheck } from '@lucide/astro';

const url = new URL(Astro.request.url);
const statusParam = url.searchParams.get('status')?.trim() ?? 'submitted';
const valid = ['submitted', 'confirmed', 'rejected', 'all'];
const status = valid.includes(statusParam) ? statusParam : 'submitted';

const db = getDb();
const [rows, counts, revenue] = await Promise.all([
  listPaymentsForAdmin(db, status === 'all' ? undefined : (status as PaymentStatus)),
  countPaymentsByStatus(db),
  revenueSummary(db),
]);

const filters = [
  { key: 'submitted', label: 'Awaiting confirmation', count: counts.submitted },
  { key: 'confirmed', label: 'Confirmed', count: counts.confirmed },
  { key: 'rejected', label: 'Rejected', count: counts.rejected },
  { key: 'all', label: 'All', count: counts.submitted + counts.confirmed + counts.rejected },
];

const submitted = rows.filter((row) => row.status === 'submitted');
const decided = rows.filter((row) => row.status !== 'submitted');

const dateLabel = (value: string | null) =>
  value ? new Date(value).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
---

<AdminLayout title="Payments — Admin" active="payments">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Manual UPI</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Payments</h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Owners pay by UPI and submit a reference; confirm here once the money is in the account.
        Only confirmed payments count as revenue.
        {counts.submitted > 0 && (
          <span class="ml-1 font-semibold text-amber-700">
            {counts.submitted} awaiting confirmation.
          </span>
        )}
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        filters.map((f) => (
          <a
            href={`/admin/payments?status=${f.key}`}
            class:list={['chip min-h-10 gap-1.5', status === f.key && 'is-active']}
            aria-current={status === f.key ? 'page' : undefined}
          >
            {f.label}
            <span class:list={['text-xs font-bold', status === f.key ? 'text-white/80' : 'text-slate-400']}>
              {f.count}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  {/* Revenue */}
  <div data-reveal-group class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="card p-5" data-reveal>
      <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase">
        <TrendingUp class="h-4 w-4" /> Confirmed revenue
      </p>
      <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">{formatINR(revenue.confirmedTotal)}</p>
      <p class="mt-0.5 text-xs text-slate-400">From {revenue.confirmedCount} confirmed payment{revenue.confirmedCount === 1 ? '' : 's'}</p>
    </div>
    <div class="card p-5" data-reveal>
      <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase">
        <Clock3 class="h-4 w-4" /> Awaiting confirmation
      </p>
      <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">{revenue.pendingCount}</p>
      <p class="mt-0.5 text-xs text-slate-400">Not counted as revenue yet</p>
    </div>
    <div class="card p-5" data-reveal>
      <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase">
        <CircleCheck class="h-4 w-4" /> Confirmed
      </p>
      <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">{revenue.confirmedCount}</p>
      <p class="mt-0.5 text-xs text-slate-400">Entitlements activated</p>
    </div>
    <div class="card p-5" data-reveal>
      <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase">
        <X class="h-4 w-4" /> Rejected
      </p>
      <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">{revenue.rejectedCount}</p>
      <p class="mt-0.5 text-xs text-slate-400">Kept for the audit trail</p>
    </div>
  </div>

  <!-- Awaiting confirmation -->
  {submitted.length > 0 && (
    <section class="mt-8" aria-labelledby="submitted-heading">
      <h2 id="submitted-heading" class="flex items-center gap-2 text-base font-bold text-slate-900">
        <HandCoins class="h-4 w-4 text-brand-600" /> Awaiting confirmation
      </h2>
      <div class="mt-4 flex flex-col gap-3">
        {submitted.map((payment) => (
          <article class="card border-amber-200 p-5" data-payment={payment.id}>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`badge ${paymentStatusMeta[payment.status].classes}`}>
                    {paymentStatusMeta[payment.status].label}
                  </span>
                  <span class="text-xs font-medium text-slate-500">
                    {payment.planName ?? payment.plan} · {payment.ownerName ?? 'Owner'}
                    {payment.ownerEmail ? ` · ${payment.ownerEmail}` : ''}
                  </span>
                </div>
                <p class="mt-2 text-sm font-bold text-slate-900">
                  {formatINR(payment.amountInr)}
                  <span class="ml-2 font-medium text-slate-500">
                    ref <span class="font-mono">{payment.reference}</span>
                  </span>
                </p>
                <p class="mt-0.5 text-xs font-medium text-slate-500">
                  {payment.listingName ? `Listing: ${payment.listingName} · ` : 'No listing attached · '}
                  Submitted {dateLabel(payment.submittedAt)}
                </p>
                {payment.payerNote && (
                  <p class="mt-2 border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600">
                    {payment.payerNote}
                  </p>
                )}
              </div>
              <div class="flex shrink-0 flex-wrap gap-2">
                <button
                  type="button"
                  class="btn-primary min-h-10 px-4 text-xs"
                  data-payment-action="confirmed"
                  data-payment-id={payment.id}
                  data-payment-label={`${formatINR(payment.amountInr)} from ${payment.ownerName ?? 'owner'}`}
                >
                  <Check class="h-4 w-4" /> Confirm received
                </button>
                <button
                  type="button"
                  class="btn-secondary min-h-10 px-4 text-xs"
                  data-payment-action="rejected"
                  data-payment-id={payment.id}
                  data-payment-label={`${formatINR(payment.amountInr)} from ${payment.ownerName ?? 'owner'}`}
                >
                  <X class="h-4 w-4" /> Reject
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Decided -->
  <section class="mt-10" aria-labelledby="decided-heading">
    <h2 id="decided-heading" class="text-base font-bold text-slate-900">
      {status === 'submitted' ? 'Recently decided' : 'Payments'}
    </h2>

    {decided.length === 0 ? (
      <p class="mt-4 border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">
        {submitted.length === 0
          ? 'Nothing here yet. Owner payment claims land here the moment they submit a UPI reference.'
          : 'No decided payments in this view.'}
      </p>
    ) : (
      <div class="mt-4 overflow-x-auto border border-slate-200">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Owner</th>
              <th scope="col" class="px-4 py-3 font-semibold">Plan</th>
              <th scope="col" class="px-4 py-3 font-semibold">Amount</th>
              <th scope="col" class="px-4 py-3 font-semibold">Reference</th>
              <th scope="col" class="px-4 py-3 font-semibold">Status</th>
              <th scope="col" class="px-4 py-3 font-semibold">Submitted</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {decided.map((payment) => (
              <tr>
                <td class="px-4 py-3">
                  <p class="font-semibold text-slate-800">{payment.ownerName ?? 'Owner'}</p>
                  <p class="text-xs text-slate-500">{payment.ownerEmail ?? ''}</p>
                </td>
                <td class="px-4 py-3 text-slate-700">{payment.planName ?? payment.plan}</td>
                <td class="px-4 py-3 font-semibold text-slate-700">{formatINR(payment.amountInr)}</td>
                <td class="px-4 py-3 font-mono text-xs text-slate-600">{payment.reference}</td>
                <td class="px-4 py-3">
                  <span class={`badge ${paymentStatusMeta[payment.status].classes}`}>
                    {paymentStatusMeta[payment.status].label}
                  </span>
                </td>
                <td class="px-4 py-3 text-xs text-slate-500">{dateLabel(payment.submittedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <script>
    import { openAdminDialog, sendAdmin } from '@/lib/adminActions';
    import { toast } from '@/lib/toast';
    import { bootMotionUI } from '@/lib/motion/ui';

    bootMotionUI();

    document.querySelectorAll<HTMLElement>('[data-payment-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.paymentAction ?? '';
        const id = button.dataset.paymentId ?? '';
        const label = button.dataset.paymentLabel ?? 'this payment';
        if (!id) return;

        if (action === 'rejected') {
          openAdminDialog({
            title: `Reject payment from ${label}?`,
            description: 'The owner sees this note. The row is kept for the audit trail.',
            submitLabel: 'Reject payment',
            tone: 'danger',
            fields: [
              {
                name: 'note',
                label: 'Reason',
                type: 'textarea',
                required: true,
                rows: 3,
                placeholder: 'e.g. No matching credit found for this UTR on the statement.',
              },
            ],
            onSubmit: async (values) => {
              const result = await sendAdmin('PUT', `/api/admin/payments/${encodeURIComponent(id)}`, {
                decision: 'rejected',
                note: values.note,
              });
              if (!result.error) {
                toast.success('Payment rejected');
                window.setTimeout(() => window.location.reload(), 450);
              }
              return result;
            },
          });
          return;
        }

        openAdminDialog({
          title: `Confirm payment from ${label}?`,
          description:
            'Only confirm once the money is in the account. This opens the paid plan window on the attached listing.',
          submitLabel: 'Confirm received',
          fields: [
            { name: 'note', label: 'Internal note', type: 'text', placeholder: 'Optional, e.g. matched against statement 12 Oct.' },
          ],
          onSubmit: async (values) => {
            const result = await sendAdmin('PUT', `/api/admin/payments/${encodeURIComponent(id)}`, {
              decision: 'confirmed',
              note: values.note || undefined,
            });
            if (!result.error) {
              toast.success('Payment confirmed', 'The plan window is now open.');
              window.setTimeout(() => window.location.reload(), 450);
            }
            return result;
          },
        });
      });
    });
  </script>
</AdminLayout>
