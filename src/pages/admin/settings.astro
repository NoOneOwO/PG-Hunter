---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb, currentUser, publicUser } from '@/lib/server/auth';
import { ShieldCheck, Database, HardDrive, ScrollText, Users, CircleCheck, TriangleAlert } from '@lucide/astro';

const user = await currentUser(Astro as any);
const db = getDb();

// Live probes: each card below is backed by a real query so the page can never
// drift from the truth. A failing probe reports the failure instead of guessing.
const probe = async <T,>(fn: () => Promise<T>, fallback: T): Promise<T> => {
  try {
    return await fn();
  } catch {
    return fallback;
  }
};

const usersCount = await probe(() => db.prepare(`SELECT COUNT(*) as n FROM users`).first<{ n: number }>(), null);
const sessionsCount = await probe(() => db.prepare(`SELECT COUNT(*) as n FROM sessions`).first<{ n: number }>(), null);
const mediaCount = await probe(() => db.prepare(`SELECT COUNT(*) as n FROM media`).first<{ n: number }>(), null);
const rateLimitCount = await probe(() => db.prepare(`SELECT COUNT(*) as n FROM rate_limits`).first<{ n: number }>(), null);

const audit = await probe(
  () =>
    db
      .prepare(
        `SELECT m.*, u.name as admin_name
         FROM moderation_actions m
         LEFT JOIN users u ON u.id = m.admin_user_id
         ORDER BY m.created_at DESC LIMIT 8`
      )
      .all(),
  { results: [] } as any
);

const dbOk = usersCount !== null;
const admin = user ? publicUser(user) : null;
const initials = (admin?.name ?? 'AD')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0]?.toUpperCase() ?? '')
  .join('');

const probes = [
  { label: 'D1 database', value: dbOk ? 'Reachable' : 'Unavailable', ok: dbOk, Icon: Database, hint: 'Cloudflare D1 (SQLite)' },
  { label: 'R2 media', value: mediaCount !== null ? `${mediaCount.n} objects` : 'Unknown', ok: mediaCount !== null, Icon: HardDrive, hint: 'Object storage for photos & docs' },
  { label: 'Accounts', value: usersCount !== null ? `${usersCount.n} users` : 'Unknown', ok: usersCount !== null, Icon: Users, hint: 'Students + owners' },
  { label: 'Rate limits', value: rateLimitCount !== null ? `${rateLimitCount.n} buckets` : 'Unknown', ok: rateLimitCount !== null, Icon: ShieldCheck, hint: 'Abuse protection rows' },
];
---

<AdminLayout title="Settings — Admin" active="settings">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Control room</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Settings</h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Who you are, what the platform runs on, and the audit trail behind every moderation decision.
      </p>
    </div>
    <span class:list={['badge px-3 py-2', dbOk ? 'border border-emerald-200 bg-emerald-50 text-emerald-800' : 'border border-rose-200 bg-rose-50 text-rose-700']}>
      {dbOk ? <CircleCheck class="h-3.5 w-3.5" /> : <TriangleAlert class="h-3.5 w-3.5" />}
      {dbOk ? 'Systems nominal' : 'Check D1 binding'}
    </span>
  </div>

  <div data-reveal-group class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      probes.map((p) => (
        <div class="card p-5" data-hover-lift>
          <span class:list={['flex h-10 w-10 items-center justify-center', p.ok ? 'bg-brand-50 text-brand-700' : 'bg-rose-50 text-rose-600']}>
            <p.Icon class="h-5 w-5" />
          </span>
          <p class="mt-4 text-lg font-extrabold tracking-tight text-slate-900">{p.value}</p>
          <p class="text-sm font-semibold text-slate-500">{p.label}</p>
          <p class="mt-0.5 text-xs text-slate-400">{p.hint}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="card" data-reveal aria-labelledby="account-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="account-heading" class="text-sm font-bold text-slate-900">Admin account</h2>
        <span class="badge bg-slate-900 text-white">is_admin</span>
      </div>
      <div class="flex items-center gap-4 px-5 py-5">
        {
          admin?.avatar ? (
            <img src={admin.avatar} alt="" width="56" height="56" class="h-14 w-14 border border-slate-200 object-cover" />
          ) : (
            <span class="flex h-14 w-14 items-center justify-center bg-brand-50 text-lg font-extrabold text-brand-700">{initials}</span>
          )
        }
        <div class="min-w-0">
          <p class="truncate text-base font-extrabold text-slate-900">{admin?.name ?? '—'}</p>
          <p class="truncate text-sm text-slate-500">{admin?.email ?? '—'}</p>
          <p class="mt-1 text-xs text-slate-400">
            Role: {admin?.role ?? '—'} · Signed in via {admin?.provider === 'google' ? 'Google' : 'email'} · Joined{' '}
            {admin?.createdAt ? new Date(admin.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}
          </p>
        </div>
      </div>
      <dl class="grid grid-cols-2 gap-px border-t border-slate-100 bg-slate-100 text-sm">
        <div class="bg-white px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500">Active sessions</dt>
          <dd class="mt-0.5 text-base font-extrabold text-slate-900">{sessionsCount?.n ?? '—'}</dd>
        </div>
        <div class="bg-white px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500">Admin guard</dt>
          <dd class="mt-0.5 text-base font-extrabold text-slate-900">requireAdmin()</dd>
        </div>
      </dl>
    </section>

    <section class="card" data-reveal aria-labelledby="platform-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="platform-heading" class="text-sm font-bold text-slate-900">Platform</h2>
        <span class="badge border border-slate-200 bg-white text-slate-600">production</span>
      </div>
      <ul class="divide-y divide-slate-100 text-sm">
        <li class="flex items-center justify-between px-5 py-3">
          <span class="font-semibold text-slate-700">Runtime</span>
          <span class="text-slate-500">Astro 6 · Cloudflare Workers</span>
        </li>
        <li class="flex items-center justify-between px-5 py-3">
          <span class="font-semibold text-slate-700">Data</span>
          <span class="text-slate-500">D1 (SQLite) · R2 (media)</span>
        </li>
        <li class="flex items-center justify-between px-5 py-3">
          <span class="font-semibold text-slate-700">Auth</span>
          <span class="text-slate-500">Session cookie + Google OAuth</span>
        </li>
        <li class="flex items-center justify-between px-5 py-3">
          <span class="font-semibold text-slate-700">Admin model</span>
          <span class="text-slate-500">users.is_admin flag (no third role)</span>
        </li>
        <li class="flex items-center justify-between px-5 py-3">
          <span class="font-semibold text-slate-700">Audit trail</span>
          <span class="text-slate-500">moderation_actions</span>
        </li>
      </ul>
      <p class="border-t border-slate-100 px-5 py-3 text-xs text-slate-400">
        No secret-management UI in this phase — credentials live in Worker secrets.
      </p>
    </section>

    <section class="card lg:col-span-2" data-reveal aria-labelledby="audit-heading">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <h2 id="audit-heading" class="flex items-center gap-2 text-sm font-bold text-slate-900">
          <ScrollText class="h-4 w-4 text-brand-600" /> Moderation audit log
        </h2>
        <a href="/admin/pgs" class="text-xs font-semibold text-brand-700 hover:underline">Moderate listings</a>
      </div>
      {
        audit.results.length === 0 ? (
          <p class="px-5 py-8 text-center text-sm text-slate-500">
            No moderation decisions yet. Every approve, reject and resolve lands here automatically.
          </p>
        ) : (
          <ul class="divide-y divide-slate-100">
            {audit.results.map((a: any) => (
              <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3">
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-slate-800">
                    <span class="badge mr-2 border border-slate-200 bg-white text-slate-600">{a.target_type}</span>
                    {a.action}
                  </p>
                  <p class="truncate text-xs text-slate-500">
                    {a.admin_name ?? 'Admin'} · {a.reason || 'no reason recorded'}
                  </p>
                </div>
                <time class="text-xs text-slate-400" datetime={a.created_at}>
                  {new Date(a.created_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                </time>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <script>
    import { bootMotionUI } from '@/lib/motion/ui';
    bootMotionUI();
  </script>
</AdminLayout>
