---
/**
 * Experience moderation.
 *
 * Server-rendered so the queue is visible on first paint; the actions post to
 * /api/admin/experiences/:id, which writes the moderation_actions audit row.
 * Only an approved experience appears on a public PG page.
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';
import { Check, X, Ban, Star, ExternalLink } from '@lucide/astro';

const url = new URL(Astro.request.url);
const statusParam = url.searchParams.get('status')?.trim() ?? 'pending';
const valid = ['pending', 'approved', 'rejected', 'spam', 'all'];
const status = valid.includes(statusParam) ? statusParam : 'pending';

const db = getDb();
const where = status === 'all' ? '' : 'WHERE e.status = ?';
const res = await db
  .prepare(
    `SELECT e.*, u.name AS user_name, u.email AS user_email, ol.name AS listing_name
     FROM pg_experiences e
     LEFT JOIN users u ON u.id = e.user_id
     LEFT JOIN owner_listings ol ON ol.id = e.listing_id
     ${where}
     ORDER BY CASE e.status WHEN 'pending' THEN 0 WHEN 'spam' THEN 1 ELSE 2 END, e.created_at DESC
     LIMIT 100`
  )
  .bind(...(status === 'all' ? [] : [status]))
  .all();

const counts = await db
  .prepare(`SELECT status, COUNT(*) AS c FROM pg_experiences GROUP BY status`)
  .all<{ status: string; c: number }>()
  .catch(() => ({ results: [] as { status: string; c: number }[] }));
const countOf = (s: string) => counts.results.find((row) => row.status === s)?.c ?? 0;

const statusMeta: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-800',
  approved: 'bg-emerald-100 text-emerald-800',
  rejected: 'bg-slate-100 text-slate-600',
  spam: 'bg-rose-100 text-rose-700',
};

const filters = [
  { key: 'pending', label: 'Pending', count: countOf('pending') },
  { key: 'approved', label: 'Approved', count: countOf('approved') },
  { key: 'rejected', label: 'Rejected', count: countOf('rejected') },
  { key: 'spam', label: 'Spam', count: countOf('spam') },
  { key: 'all', label: 'All', count: countOf('pending') + countOf('approved') + countOf('rejected') + countOf('spam') },
];
---

<AdminLayout title="Experiences — Admin" active="experiences">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Moderation</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        Student experiences
      </h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Pending by default. Only <strong class="font-semibold text-emerald-700">approved</strong> experiences
        appear on a public PG page, and every decision is written to the audit log.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        filters.map((f) => (
          <a
            href={`/admin/experiences?status=${f.key}`}
            class:list={[
              'chip min-h-10 gap-1.5',
              status === f.key && 'is-active',
            ]}
            aria-current={status === f.key ? 'page' : undefined}
          >
            {f.label}
            <span class:list={['text-xs font-bold', status === f.key ? 'text-white/80' : 'text-slate-400']}>
              {f.count}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  {res.results.length === 0 ? (
    <div class="card pixel-corner relative mt-8 px-6 py-14 text-center">
      <div class="pixel-rule justify-center" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <p class="mt-5 text-base font-bold text-slate-900">Nothing to moderate here</p>
      <p class="mt-1 text-sm text-slate-500">
        Student experiences land in this queue the moment they are submitted.
      </p>
    </div>
  ) : (
    <div class="mt-6 flex flex-col gap-4">
      {res.results.map((e: any) => (
        <article class="card p-5" data-reveal>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class={`badge ${statusMeta[e.status] ?? 'bg-slate-100 text-slate-600'}`}>{e.status}</span>
                {e.rating ? (
                  <span class="badge border border-amber-200 bg-amber-50 text-amber-800">
                    <Star class="h-3.5 w-3.5 fill-current" /> {e.rating}/5
                  </span>
                ) : (
                  <span class="badge border border-slate-200 bg-white text-slate-500">No rating</span>
                )}
                <span class="text-xs font-medium text-slate-500">
                  {new Date(e.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
              </div>

              <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-slate-700">
                {e.content?.slice(0, 900) ?? '—'}
              </p>

              <p class="mt-3 text-xs font-medium text-slate-500">
                {e.user_name ?? 'Student'} · {e.user_email ?? '—'} ·{' '}
                {e.listing_name ? (
                  <a href={`/pgs/live/${encodeURIComponent(e.listing_id)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-brand-700 hover:underline">
                    {e.listing_name} <ExternalLink class="h-3 w-3" />
                  </a>
                ) : (
                  <span>listing {e.listing_id}</span>
                )}
              </p>

              {e.status !== 'pending' && (
                <p class="mt-2 text-xs text-slate-400">
                  Last decision saved {new Date(e.updated_at).toLocaleDateString('en-IN')}
                </p>
              )}
            </div>

            <div class="flex shrink-0 flex-wrap gap-2">
              {e.status !== 'approved' && (
                <button
                  type="button"
                  class="btn-primary min-h-10 px-4 text-xs"
                  data-exp-action="approve"
                  data-exp-id={e.id}
                >
                  <Check class="h-4 w-4" /> Approve
                </button>
              )}
              {e.status !== 'rejected' && (
                <button
                  type="button"
                  class="btn-secondary min-h-10 px-4 text-xs"
                  data-exp-action="reject"
                  data-exp-id={e.id}
                >
                  <X class="h-4 w-4" /> Reject
                </button>
              )}
              {e.status !== 'spam' && (
                <button
                  type="button"
                  class="btn-ghost-danger min-h-10"
                  data-exp-action="spam"
                  data-exp-id={e.id}
                >
                  <Ban class="h-4 w-4" /> Spam
                </button>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}

  <script>
    import { openAdminDialog, sendAdmin } from '@/lib/adminActions';
    import { toast } from '@/lib/toast';
    import { bootMotionUI } from '@/lib/motion/ui';

    bootMotionUI();

    const LABELS: Record<string, string> = {
      approve: 'Approve experience',
      reject: 'Reject experience',
      spam: 'Mark as spam',
    };

    document.querySelectorAll<HTMLElement>('[data-exp-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.expAction ?? '';
        const id = button.dataset.expId ?? '';
        if (!id) return;

        openAdminDialog({
          title: LABELS[action] ?? 'Moderate experience',
          description:
            action === 'approve'
              ? 'It becomes visible on the public PG page immediately.'
              : 'The student is not notified automatically; the reason is kept in the audit log.',
          submitLabel: LABELS[action] ?? 'Confirm',
          tone: action === 'approve' ? 'primary' : 'danger',
          fields:
            action === 'approve'
              ? []
              : [
                  {
                    name: 'reason',
                    label: 'Reason',
                    type: 'textarea',
                    rows: 3,
                    placeholder:
                      action === 'spam'
                        ? 'e.g. Promotional text, contact details, or copied content.'
                        : 'e.g. Names a specific person and contains an unverifiable claim.',
                    hint: 'Optional, up to 500 characters — stored on the moderation audit row.',
                  },
                ],
          onSubmit: async (values) => {
            const result = await sendAdmin(
              'POST',
              `/api/admin/experiences/${encodeURIComponent(id)}`,
              { action, reason: values.reason || undefined }
            );
            if (!result.error) {
              toast.success('Decision saved', 'The moderation audit log has the record.');
              window.setTimeout(() => window.location.reload(), 450);
            }
            return result;
          },
        });
      });
    });
  </script>
</AdminLayout>
