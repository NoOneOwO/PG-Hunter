---
/**
 * Analytics — real D1 aggregates only.
 *
 * `pg_engagement_events` is the historical log (views, saves, reactions,
 * enquiry events); leads and experiences are counted from their own tables so
 * a moderation rejection never silently changes an engagement number.
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';
import { Eye, Heart, ThumbsUp, ThumbsDown, MessageCircle, Star, TrendingUp, ChartColumn } from '@lucide/astro';

const db = getDb();

const [eventsRes, leadsRes, expsRes, topRes, listingStatusRes] = await Promise.all([
  db
    .prepare(
      `SELECT substr(created_at, 1, 10) AS day, event_type, COUNT(*) AS c
       FROM pg_engagement_events
       WHERE created_at >= date('now', '-13 days')
       GROUP BY day, event_type`
    )
    .all<{ day: string; event_type: string; c: number }>()
    .catch(() => ({ results: [] as { day: string; event_type: string; c: number }[] })),
  db
    .prepare(
      `SELECT substr(created_at, 1, 10) AS day, COUNT(*) AS c FROM leads
       WHERE created_at >= date('now', '-13 days') GROUP BY day`
    )
    .all<{ day: string; c: number }>()
    .catch(() => ({ results: [] as { day: string; c: number }[] })),
  db
    .prepare(
      `SELECT substr(created_at, 1, 10) AS day, COUNT(*) AS c FROM pg_experiences
       WHERE created_at >= date('now', '-13 days') GROUP BY day`
    )
    .all<{ day: string; c: number }>()
    .catch(() => ({ results: [] as { day: string; c: number }[] })),
  db
    .prepare(
      `SELECT e.listing_id, COUNT(*) AS views,
              COALESCE(ol.name, e.listing_id) AS name,
              (SELECT COUNT(*) FROM leads l WHERE l.property_id = e.listing_id) AS enquiries
       FROM pg_engagement_events e
       LEFT JOIN owner_listings ol ON ol.id = e.listing_id
       WHERE e.event_type = 'VIEW' AND e.listing_id IS NOT NULL
       GROUP BY e.listing_id
       ORDER BY views DESC
       LIMIT 8`
    )
    .all<{ listing_id: string; name: string; views: number; enquiries: number }>()
    .catch(() => ({ results: [] as any[] })),
  db
    .prepare(`SELECT status, COUNT(*) AS c FROM owner_listings GROUP BY status`)
    .all<{ status: string; c: number }>()
    .catch(() => ({ results: [] as { status: string; c: number }[] })),
]);

// Totals across all time (not just the 14-day window).
const totalsRes = await db
  .prepare(`SELECT event_type, COUNT(*) AS c FROM pg_engagement_events GROUP BY event_type`)
  .all<{ event_type: string; c: number }>()
  .catch(() => ({ results: [] as { event_type: string; c: number }[] }));
const total = (type: string) => totalsRes.results.find((row) => row.event_type === type)?.c ?? 0;

/** Last 14 days, oldest → newest, so the chart reads left to right. */
const days = Array.from({ length: 14 }, (_, i) => {
  const date = new Date();
  date.setDate(date.getDate() - (13 - i));
  return date.toISOString().slice(0, 10);
});

const series = (rows: { day: string; c: number }[]) =>
  days.map((day) => rows.find((row) => row.day === day)?.c ?? 0);

const eventSeries = (type: string) =>
  days.map((day) =>
    eventsRes.results
      .filter((row) => row.day === day && row.event_type === type)
      .reduce((sum, row) => sum + row.c, 0)
  );

const viewsByDay = eventSeries('VIEW');
const savesByDay = eventSeries('SAVE');
const likesByDay = eventSeries('LIKE');
const dislikesByDay = eventSeries('DISLIKE');
const enquiriesByDay = series(leadsRes.results);
const experiencesByDay = series(expsRes.results);

const sum = (values: number[]) => values.reduce((a, b) => a + b, 0);

const charts = [
  { title: 'Views', values: viewsByDay, total: sum(viewsByDay), className: 'bg-brand-500' },
  { title: 'Saves', values: savesByDay, total: sum(savesByDay), className: 'bg-sky-500' },
  { title: 'Enquiries', values: enquiriesByDay, total: sum(enquiriesByDay), className: 'bg-emerald-500' },
  { title: 'Experiences', values: experiencesByDay, total: sum(experiencesByDay), className: 'bg-accent-400' },
  { title: 'Likes', values: likesByDay, total: sum(likesByDay), className: 'bg-emerald-500' },
  { title: 'Dislikes', values: dislikesByDay, total: sum(dislikesByDay), className: 'bg-rose-500' },
];

const grandTotals = [
  { label: 'Views', value: total('VIEW'), Icon: Eye },
  { label: 'Saves', value: total('SAVE'), Icon: Heart },
  { label: 'Likes', value: total('LIKE'), Icon: ThumbsUp },
  { label: 'Dislikes', value: total('DISLIKE'), Icon: ThumbsDown },
  { label: 'Enquiry events', value: total('ENQUIRY'), Icon: MessageCircle },
  { label: 'Experiences', value: expsRes.results.reduce((a, row) => a + row.c, 0), Icon: Star },
];

const maxOf = (values: number[]) => Math.max(1, ...values);
const listingStatus = (status: string) =>
  listingStatusRes.results.find((row) => row.status === status)?.c ?? 0;
---

<AdminLayout title="Analytics — Admin" active="analytics">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Last 14 days</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Analytics</h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Straight from <code class="rounded bg-slate-100 px-1 py-0.5 text-xs">pg_engagement_events</code>,
        leads and experiences. No warehouse, no sampling, no invented numbers.
      </p>
    </div>
  </div>

  {/* All-time totals */}
  <div data-reveal-group class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-6">
    {
      grandTotals.map((item) => (
        <div class="card p-4" data-reveal>
          <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase">
            <item.Icon class="h-4 w-4" /> {item.label}
          </p>
          <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900" data-count-up={item.value}>
            {item.value}
          </p>
        </div>
      ))
    }
  </div>

  {/* Daily charts */}
  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    {
      charts.map((chart) => (
        <section class="card p-5" data-reveal>
          <div class="flex items-center justify-between gap-3">
            <h2 class="flex items-center gap-2 text-sm font-bold text-slate-900">
              <ChartColumn class="h-4 w-4 text-brand-600" /> {chart.title} · last 14 days
            </h2>
            <span class="badge border border-slate-200 bg-white text-slate-600">{chart.total} total</span>
          </div>

          {chart.total === 0 ? (
            <p class="mt-4 border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">
              No {chart.title.toLowerCase()} recorded in this window.
            </p>
          ) : (
            <div class="mt-5 flex h-40 items-end gap-1" data-chart aria-label={`${chart.title} per day, last 14 days`}>
              {chart.values.map((value, index) => (
                <div class="group relative flex h-full flex-1 items-end">
                  <div
                    class={`w-full ${chart.className} origin-bottom`}
                    data-bar
                    style={`height: ${Math.max(value > 0 ? 4 : 0, Math.round((value / maxOf(chart.values)) * 100))}%`}
                    title={`${days[index]}: ${value}`}
                  />
                  <span class="pointer-events-none absolute -top-7 left-1/2 -translate-x-1/2 rounded-sm bg-slate-900 px-1.5 py-0.5 text-[10px] font-semibold text-white opacity-0 transition-opacity group-hover:opacity-100">
                    {value}
                  </span>
                </div>
              ))}
            </div>
          )}

          <div class="mt-2 flex justify-between text-[10px] font-medium text-slate-400">
            <span>{days[0].slice(5)}</span>
            <span>{days[days.length - 1].slice(5)}</span>
          </div>
        </section>
      ))
    }
  </div>

  {/* Top listings */}
  <section class="card mt-8" aria-labelledby="top-listings-heading" data-reveal>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-3">
      <h2 id="top-listings-heading" class="flex items-center gap-2 text-sm font-bold text-slate-900">
        <TrendingUp class="h-4 w-4 text-brand-600" /> Most-viewed listings
      </h2>
      <span class="text-xs font-medium text-slate-500">
        Pipeline: {listingStatus('active')} live · {listingStatus('pending')} pending ·{' '}
        {listingStatus('rejected')} rejected · {listingStatus('draft')} draft
      </span>
    </div>
    {topRes.results.length === 0 ? (
      <p class="p-5 text-sm text-slate-500">
        No listing views recorded yet. Views start counting the moment a public listing page loads.
      </p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-slate-50 text-xs tracking-wide text-slate-500 uppercase">
            <tr>
              <th class="px-5 py-2.5 font-semibold">Listing</th>
              <th class="px-5 py-2.5 font-semibold">Views</th>
              <th class="px-5 py-2.5 font-semibold">Enquiries</th>
              <th class="px-5 py-2.5 font-semibold">View → enquiry</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {topRes.results.map((row: any) => (
              <tr class="transition-colors hover:bg-slate-50">
                <td class="px-5 py-3">
                  <a
                    href={`/pgs/live/${encodeURIComponent(row.listing_id)}`}
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-slate-800 hover:text-brand-700 hover:underline"
                  >
                    {row.name}
                  </a>
                </td>
                <td class="px-5 py-3 font-semibold text-slate-700">{row.views}</td>
                <td class="px-5 py-3 font-semibold text-slate-700">{row.enquiries}</td>
                <td class="px-5 py-3 text-slate-600">
                  {row.views > 0 ? `${((row.enquiries / row.views) * 100).toFixed(1)}%` : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <script>
    import { initCountUps } from '@/lib/countUp';
    import { bootMotionUI } from '@/lib/motion/ui';
    import { animate } from 'motion';

    bootMotionUI();
    initCountUps();

    // Bars grow from the baseline once, using the same spring language as the
    // rest of the site; reduced-motion users keep the static height.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      for (const chart of document.querySelectorAll('[data-chart]')) {
        const bars = Array.from(chart.querySelectorAll<HTMLElement>('[data-bar]'));
        bars.forEach((bar, index) => {
          animate(
            bar,
            { scaleY: [0, 1], opacity: [0.4, 1] },
            { duration: 0.45, delay: index * 0.02, ease: 'easeOut' }
          );
        });
      }
    }
  </script>
</AdminLayout>
