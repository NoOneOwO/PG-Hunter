---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.trim() ?? '';
const status = url.searchParams.get('status')?.trim() ?? '';
const verification = url.searchParams.get('verification')?.trim() ?? '';

const validStatuses = ['draft','pending','active','rejected'];
const validVerifs = ['unverified','pg_hunter_verified','rishabh_irl_verified'];

let where: string[] = [];
let binds: any[] = [];
if (status && validStatuses.includes(status)) { where.push('ol.status = ?'); binds.push(status); }
if (verification && validVerifs.includes(verification)) { where.push('ol.verification_status = ?'); binds.push(verification); }
if (q) { where.push('(ol.name LIKE ? OR ol.locality LIKE ? OR u.email LIKE ? OR u.name LIKE ?)'); const like=`%${q}%`; binds.push(like,like,like,like); }
const whereSql = where.length ? `WHERE ${where.join(' AND ')}` : '';

const db = getDb();
const res = await db.prepare(
  `SELECT ol.*, u.name as owner_name, u.email as owner_email
   FROM owner_listings ol LEFT JOIN users u ON u.id=ol.owner_id
   ${whereSql}
   ORDER BY ol.updated_at DESC LIMIT 50`
).bind(...binds).all();

// For each listing, get counts: views, saves, enquiries
const listings = await Promise.all(res.results.map(async (r:any)=>{
  const [viewsRow, savesRow, enqRow] = await Promise.all([
    db.prepare(`SELECT COUNT(*) as c FROM pg_engagement_events WHERE listing_id=? AND event_type='VIEW'`).bind(r.id).first<{c:number}>().catch(()=>({c:0})),
    db.prepare(`SELECT COUNT(*) as c FROM saved_pgs WHERE property_id=?`).bind(r.id).first<{c:number}>().catch(()=>({c:0})),
    db.prepare(`SELECT COUNT(*) as c FROM leads WHERE property_id=?`).bind(r.id).first<{c:number}>().catch(()=>({c:0})),
  ]);
  return { ...r, views: viewsRow?.c ?? 0, saves: savesRow?.c ?? 0, enquiries: enqRow?.c ?? 0 };
}));
---

<AdminLayout title="PGs — Admin" active="pgs">
  <h1 class="text-2xl font-extrabold">PGs (D1 owner_listings)</h1>
  <p class="mt-1 text-sm text-slate-500">Public PGs are still mock in <code>src/data/properties.ts</code>. This table shows real D1 listings — admin works with the source that actually exists.</p>

  <form class="mt-4 flex flex-wrap gap-2">
    <input name="q" value={q} placeholder="Search name, locality, owner" class="field text-sm" />
    <select name="status" class="field text-sm">
      <option value="">All status</option>
      {validStatuses.map(s=>(<option value={s} selected={s===status}>{s}</option>))}
    </select>
    <select name="verification" class="field text-sm">
      <option value="">All verification</option>
      {validVerifs.map(v=>(<option value={v} selected={v===verification}>{v}</option>))}
    </select>
    <button class="btn-primary px-4 text-sm">Filter</button>
    <a href="/admin/pgs" class="btn-secondary px-4 text-sm">Clear</a>
  </form>

  <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white">
    <table class="w-full min-w-[800px] text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr><th class="px-4 py-3">PG</th><th class="px-4 py-3">Owner</th><th class="px-4 py-3">Location</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Verif</th><th class="px-4 py-3">Views</th><th class="px-4 py-3">Saves</th><th class="px-4 py-3">Enq</th><th class="px-4 py-3">Created</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {listings.length===0 ? <tr><td colspan="9" class="px-4 py-8 text-center text-sm text-slate-500">No data yet — no D1 listings for this filter.</td></tr> : listings.map((r:any)=>(
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-semibold">{r.name}</td>
            <td class="px-4 py-3 text-xs">{r.owner_name}<br/><span class="text-slate-500">{r.owner_email}</span></td>
            <td class="px-4 py-3 text-xs">{r.locality}, {r.city}</td>
            <td class="px-4 py-3"><span class="badge bg-slate-100 text-slate-700">{r.status}</span></td>
            <td class="px-4 py-3"><span class="badge bg-slate-100 text-slate-700">{r.verification_status}</span></td>
            <td class="px-4 py-3">{r.views}</td>
            <td class="px-4 py-3">{r.saves}</td>
            <td class="px-4 py-3">{r.enquiries}</td>
            <td class="px-4 py-3 text-xs">{new Date(r.created_at).toLocaleDateString()}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-slate-500">Mobile: horizontal scroll. No enormous table — 50 rows max.</p>
</AdminLayout>
