---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/server/auth';
import { Search, Eye, Bookmark, MessageCircle, ExternalLink, CircleCheck, CircleX, RotateCcw, BadgeCheck, ShieldOff } from '@lucide/astro';

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.trim() ?? '';
const status = url.searchParams.get('status')?.trim() ?? '';
const verification = url.searchParams.get('verification')?.trim() ?? '';

const validStatuses = ['draft', 'pending', 'active', 'rejected'];
const validVerifs = ['unverified', 'pg_hunter_verified', 'rishabh_irl_verified'];

let where: string[] = [];
let binds: any[] = [];
if (status && validStatuses.includes(status)) {
  where.push('ol.status = ?');
  binds.push(status);
}
if (verification && validVerifs.includes(verification)) {
  where.push('ol.verification_status = ?');
  binds.push(verification);
}
if (q) {
  where.push('(ol.name LIKE ? OR ol.locality LIKE ? OR u.email LIKE ? OR u.name LIKE ?)');
  const like = `%${q}%`;
  binds.push(like, like, like, like);
}
const whereSql = where.length ? `WHERE ${where.join(' AND ')}` : '';

const db = getDb();
const res = await db
  .prepare(
    `SELECT ol.*, u.name as owner_name, u.email as owner_email
     FROM owner_listings ol LEFT JOIN users u ON u.id = ol.owner_id
     ${whereSql}
     ORDER BY ol.updated_at DESC LIMIT 50`
  )
  .bind(...binds)
  .all();

// Per-listing engagement counts, batched in three queries instead of 3N.
const ids = res.results.map((r: any) => r.id);
const counts = new Map<string, { views: number; saves: number; enquiries: number }>();
if (ids.length) {
  const placeholders = ids.map(() => '?').join(', ');
  const [views, saves, enquiries] = await Promise.all([
    db
      .prepare(
        `SELECT listing_id, COUNT(*) AS c FROM pg_engagement_events
         WHERE listing_id IN (${placeholders}) AND event_type = 'VIEW' GROUP BY listing_id`
      )
      .bind(...ids)
      .all<{ listing_id: string; c: number }>()
      .catch(() => ({ results: [] as any[] })),
    db
      .prepare(
        `SELECT property_id, COUNT(*) AS c FROM saved_pgs WHERE property_id IN (${placeholders}) GROUP BY property_id`
      )
      .bind(...ids)
      .all<{ property_id: string; c: number }>()
      .catch(() => ({ results: [] as any[] })),
    db
      .prepare(
        `SELECT property_id, COUNT(*) AS c FROM leads WHERE property_id IN (${placeholders}) GROUP BY property_id`
      )
      .bind(...ids)
      .all<{ property_id: string; c: number }>()
      .catch(() => ({ results: [] as any[] })),
  ]);
  for (const id of ids) counts.set(id, { views: 0, saves: 0, enquiries: 0 });
  for (const row of views.results) counts.get(row.listing_id)!.views = row.c;
  for (const row of saves.results) counts.get(row.property_id)!.saves = row.c;
  for (const row of enquiries.results) counts.get(row.property_id)!.enquiries = row.c;
}

const statusMeta: Record<string, { label: string; className: string }> = {
  draft: { label: 'Draft', className: 'bg-slate-100 text-slate-600' },
  pending: { label: 'Pending review', className: 'bg-amber-100 text-amber-800' },
  active: { label: 'Live', className: 'bg-emerald-100 text-emerald-800' },
  rejected: { label: 'Rejected', className: 'bg-rose-100 text-rose-700' },
};

const verifyMeta = (status: string) =>
  status === 'rishabh_irl_verified'
    ? { label: 'Rishabh IRL Verified', className: 'bg-emerald-100 text-emerald-800' }
    : status === 'pg_hunter_verified'
      ? { label: 'PG Hunter Verified', className: 'bg-brand-100 text-brand-800' }
      : { label: 'Unverified', className: 'bg-slate-100 text-slate-500' };

const listings = res.results.map((r: any) => ({
  ...r,
  counts: counts.get(r.id) ?? { views: 0, saves: 0, enquiries: 0 },
}));
---

<AdminLayout title="Listings — Admin" active="pgs">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Moderation queue</p>
      <div class="pixel-rule mt-3" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Listings</h1>
      <p class="mt-1 text-sm font-medium text-slate-500">
        Approve, reject and verify real owner listings. Publishing never grants a badge —
        verification is recorded separately, with evidence.
      </p>
    </div>
    <div class="flex flex-wrap gap-2 text-xs font-semibold">
      <span class="badge border border-slate-200 bg-white text-slate-600">{listings.length} shown</span>
      <span class="badge border border-amber-200 bg-amber-50 text-amber-800">
        {listings.filter((l: any) => l.status === 'pending').length} awaiting review
      </span>
    </div>
  </div>

  <form class="mt-6 flex flex-wrap items-center gap-2" data-reveal>
    <label class="field w-full sm:w-72">
      <Search class="h-4 w-4 shrink-0 text-slate-400" />
      <span class="sr-only">Search</span>
      <input
        name="q"
        value={q}
        placeholder="Search name, locality, owner"
        class="w-full bg-transparent text-sm outline-none"
      />
    </label>
    <label class="field w-auto">
      <span class="sr-only">Status</span>
      <select name="status" class="appearance-none bg-transparent pr-2 text-sm outline-none">
        <option value="">All status</option>
        {validStatuses.map((s) => (
          <option value={s} selected={s === status}>
            {s}
          </option>
        ))}
      </select>
    </label>
    <label class="field w-auto">
      <span class="sr-only">Verification</span>
      <select name="verification" class="appearance-none bg-transparent pr-2 text-sm outline-none">
        <option value="">All verification</option>
        {validVerifs.map((v) => (
          <option value={v} selected={v === verification}>
            {v}
          </option>
        ))}
      </select>
    </label>
    <button class="btn-primary px-5">Filter</button>
    <a href="/admin/pgs" class="btn-secondary px-5">Clear</a>
  </form>

  {listings.length === 0 ? (
    <div class="card pixel-corner relative mt-8 px-6 py-14 text-center">
      <div class="pixel-rule justify-center" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <p class="mt-5 text-base font-bold text-slate-900">Nothing matches this filter</p>
      <p class="mt-1 text-sm text-slate-500">
        Owner listings appear here the moment an owner creates one.
      </p>
    </div>
  ) : (
    <div class="mt-6 flex flex-col gap-4">
      {listings.map((l: any) => {
        const sm = statusMeta[l.status] ?? statusMeta.draft;
        const vm = verifyMeta(l.verification_status);
        return (
          <article class="card p-5" data-reveal data-listing-id={l.id}>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-lg font-extrabold tracking-tight text-slate-900">{l.name}</h2>
                  <span class={`badge ${sm.className}`}>{sm.label}</span>
                  <span class={`badge ${vm.className}`}>{vm.label}</span>
                  {l.plan && (
                    <span class="badge border border-slate-200 bg-white text-slate-600">
                      {l.plan === 'verified' ? 'Verified plan' : 'Basic plan'}
                    </span>
                  )}
                </div>
                <p class="mt-1.5 text-sm text-slate-500">
                  {l.locality}{l.locality && l.city ? ', ' : ''}{l.city} · {l.property_type} · {l.gender}
                </p>
                <p class="mt-0.5 text-xs text-slate-500">
                  {l.owner_name ?? 'Unknown owner'} · {l.owner_email ?? '—'} · updated{' '}
                  {new Date(l.updated_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  {l.expires_at && l.status === 'active' && (
                    <> · plan ends {new Date(l.expires_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}</>
                  )}
                </p>
                {l.rejection_reason && (
                  <p class="mt-2 border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-medium text-rose-700">
                    Rejected: {l.rejection_reason}
                  </p>
                )}
              </div>

              <dl class="flex shrink-0 gap-4 text-xs">
                <div class="text-center">
                  <dt class="flex items-center gap-1 font-medium text-slate-500"><Eye class="h-3.5 w-3.5" /> Views</dt>
                  <dd class="mt-0.5 text-base font-extrabold text-slate-900">{l.counts.views}</dd>
                </div>
                <div class="text-center">
                  <dt class="flex items-center gap-1 font-medium text-slate-500"><Bookmark class="h-3.5 w-3.5" /> Saves</dt>
                  <dd class="mt-0.5 text-base font-extrabold text-slate-900">{l.counts.saves}</dd>
                </div>
                <div class="text-center">
                  <dt class="flex items-center gap-1 font-medium text-slate-500"><MessageCircle class="h-3.5 w-3.5" /> Enquiries</dt>
                  <dd class="mt-0.5 text-base font-extrabold text-slate-900">{l.counts.enquiries}</dd>
                </div>
              </dl>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
              {l.status !== 'active' && (
                <button
                  type="button"
                  class="btn-primary min-h-10 px-4 text-xs"
                  data-mod="approve"
                  data-listing-id={l.id}
                  data-listing-name={l.name}
                >
                  <CircleCheck class="h-4 w-4" /> Approve &amp; publish
                </button>
              )}
              {l.status !== 'rejected' && (
                <button
                  type="button"
                  class="btn-secondary min-h-10 px-4 text-xs"
                  data-mod="reject"
                  data-listing-id={l.id}
                  data-listing-name={l.name}
                >
                  <CircleX class="h-4 w-4" /> Reject
                </button>
              )}
              {l.status !== 'pending' && (
                <button
                  type="button"
                  class="btn-secondary min-h-10 px-4 text-xs"
                  data-mod="pending"
                  data-listing-id={l.id}
                  data-listing-name={l.name}
                >
                  <RotateCcw class="h-4 w-4" /> Back to review
                </button>
              )}

              <span class="hidden h-6 w-px bg-slate-200 sm:block" aria-hidden="true"></span>

              {l.verification_status === 'unverified' ? (
                <button
                  type="button"
                  class="btn-secondary min-h-10 px-4 text-xs"
                  data-mod="grant"
                  data-listing-id={l.id}
                  data-listing-name={l.name}
                >
                  <BadgeCheck class="h-4 w-4" /> Grant verification
                </button>
              ) : (
                <button
                  type="button"
                  class="btn-ghost-danger min-h-10"
                  data-mod="revoke"
                  data-listing-id={l.id}
                  data-listing-name={l.name}
                >
                  <ShieldOff class="h-4 w-4" /> Revoke badge
                </button>
              )}

              {l.status === 'active' && (
                <a
                  href={`/pgs/live/${encodeURIComponent(l.id)}`}
                  target="_blank"
                  rel="noopener"
                  class="ml-auto inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:underline"
                >
                  View public page <ExternalLink class="h-3.5 w-3.5" />
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  )}

  <script>
    import { bindListingModeration } from '@/lib/adminActions';
    import { bootMotionUI } from '@/lib/motion/ui';
    bootMotionUI();
    bindListingModeration();
  </script>
</AdminLayout>
