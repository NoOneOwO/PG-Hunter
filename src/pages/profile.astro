---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { colleges } from '@/data/colleges';
import ProfileApp from '@/components/profile/ProfileApp';

const collegeOptions = colleges.map((c) => ({ slug: c.slug, shortName: c.shortName, name: c.name }));
---

<BaseLayout
  title="Your Profile — PG Hunter"
  description="Manage your PG Hunter account: your details, saved PGs and sign-in options."
  noindex
>
  <ProfileApp client:load colleges={collegeOptions}>
    <div slot="fallback" class="pb-20">
      <div class="bg-slate-200/70 h-40 w-full sm:h-52"></div>
      <div class="mx-auto w-full max-w-6xl px-4 pt-8 sm:px-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:gap-6">
          <div class="-mt-12 h-24 w-24 bg-slate-200/70 sm:-mt-14 sm:h-28 sm:w-28"></div>
          <div class="flex-1">
            <div class="bg-slate-200/70 h-8 w-56"></div>
            <div class="bg-slate-200/70 mt-2 h-4 w-72"></div>
          </div>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="flex flex-col gap-6 lg:col-span-4">
            <div class="bg-slate-200/70 h-56 w-full"></div>
            <div class="bg-slate-200/70 h-72 w-full"></div>
          </div>
          <div class="lg:col-span-8">
            <div class="bg-slate-200/70 h-11 w-64"></div>
            <div class="bg-slate-200/70 mt-6 h-96 w-full"></div>
          </div>
        </div>
      </div>
      <p class="mt-6 text-center text-sm font-medium text-slate-500" role="status">Loading your profile…</p>
    </div>
  </ProfileApp>
</BaseLayout>