---
import { Play, MapPin, ArrowRight, Bookmark, Star } from '@lucide/astro';
import type { Property } from '@/data/types';
import { collegeById } from '@/data/colleges';
import { localityById } from '@/data/colleges';
import { coverImage, startingRent } from '@/data/properties';
import { formatDistance, formatINR } from '@/lib/format';
import VerificationBadge from './VerificationBadge.astro';
import AmenityChips from './AmenityChips.astro';

interface Props {
  property: Property;
  /** Preferred college context for the distance label. */
  contextCollegeId?: string;
}

const { property: p, contextCollegeId } = Astro.props;

const image = coverImage(p);
const rent = startingRent(p);
const locality = localityById(p.localityId);
const context = contextCollegeId
  ? p.collegeDistances.find((d) => d.collegeId === contextCollegeId)
  : p.collegeDistances[0];
const college = context ? collegeById(context.collegeId) : undefined;

const roomSummary = [...new Set(p.rooms.map((r) => r.occupancy))].join(' · ');
const hasVideo = p.media.some((m) => m.type === 'video');
---

<article
  class="card group relative flex flex-col overflow-hidden transition-shadow duration-150 hover:shadow-card-hover"
  data-property
  data-id={p.id}
  data-rent={rent}
  data-name={p.name.toLowerCase()}
  data-locality={(locality?.name ?? p.localityId).toLowerCase()}
  data-colleges={p.collegeDistances
    .map((d) => collegeById(d.collegeId)?.shortName)
    .filter(Boolean)
    .join(' ')
    .toLowerCase()}
  data-college-names={p.collegeDistances
    .map((d) => collegeById(d.collegeId)?.name)
    .filter(Boolean)
    .join(' ')
    .toLowerCase()}
  data-roomtypes={p.rooms.map((r) => r.roomType).join(' ')}
  data-gender={p.gender}
  data-food={p.food.available ? 'yes' : 'no'}
  data-verified={p.verificationStatus}
>
  <a href={`/pgs/${p.slug}`} class="relative block aspect-[4/3] overflow-hidden bg-slate-100" tabindex="-1" aria-hidden="true">
    {image?.provider === 'unsplash' ? (
      <img
        src={image.externalId}
        alt={image.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        width="800"
        height="600"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-brand-50 text-brand-300">
        <Play class="h-10 w-10" />
      </div>
    )}

    <div class="absolute left-3 top-3">
      <VerificationBadge status={p.verificationStatus} compact />
    </div>

    {hasVideo && (
      <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-slate-900/70 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur">
        <Play class="h-3 w-3 fill-current" />
        Video walkthrough
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col gap-2.5 p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-base font-bold leading-snug text-slate-900">
        <a href={`/pgs/${p.slug}`} class="after:absolute after:inset-0">{p.name}</a>
      </h3>
      <button
        type="button"
        data-save-btn
        data-property-id={p.id}
        class="relative z-10 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-brand-50 hover:text-brand-600"
        aria-label={`Save ${p.name} to your shortlist`}
        aria-pressed="false"
        title="Save to shortlist"
      >
        <Bookmark class="h-5 w-5" />
      </button>
    </div>

    <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs font-medium text-slate-500">
      <MapPin class="h-3.5 w-3.5 text-brand-600" />
      <span>{locality?.name ?? p.localityId}</span>
      {college && (
        <>
          <span aria-hidden="true">·</span>
          <span>{formatDistance(context!.distanceMeters)} from {college.shortName}</span>
        </>
      )}
    </p>

    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
      <span class="text-xl font-extrabold text-brand-700">{formatINR(rent)}</span>
      <span class="text-xs font-medium text-slate-500">/month starting from</span>
    </div>

    {p.rating !== null && p.rating > 0 ? (
      <p class="inline-flex items-center gap-1 text-sm font-semibold text-slate-800">
        <Star class="h-4 w-4 fill-accent-400 text-accent-400" />
        {p.rating.toFixed(1)}
        <span class="font-normal text-slate-400">({p.reviewCount})</span>
      </p>
    ) : (
      <p class="text-sm font-semibold text-slate-700">{roomSummary}</p>
    )}

    <AmenityChips slugs={p.amenitySlugs} limit={3} compact />

    <div class="mt-auto flex items-center gap-3 border-t border-slate-100 pt-3">
      <a
        href={`/pgs/${p.slug}`}
        class="inline-flex min-h-11 flex-1 items-center justify-center gap-1.5 rounded-xl bg-brand-50 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-100"
      >
        View Details
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</article>

<script>
  // Save-to-shortlist wiring. Runs once per page (Astro dedupes component scripts).
  import { getCurrentSession, isSaved, toggleSaved } from '@/lib/auth';

  const setState = (btn: HTMLButtonElement, saved: boolean) => {
    const svg = btn.querySelector('svg');
    btn.classList.toggle('text-brand-600', saved);
    btn.setAttribute('aria-pressed', String(saved));
    btn.setAttribute('aria-label', saved ? 'Remove from shortlist' : 'Save to shortlist');
    btn.title = saved ? 'Remove from shortlist' : 'Save to shortlist';
    if (svg) svg.style.fill = saved ? 'currentColor' : 'none';
  };

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-save-btn]'));

  const init = async () => {
    for (const btn of buttons) {
      const propertyId = btn.dataset.propertyId ?? '';
      setState(btn, await isSaved(propertyId));

      btn.addEventListener('click', async () => {
        const session = await getCurrentSession();
        if (!session) {
          const here = window.location.pathname + window.location.search;
          window.location.href = `/login?next=${encodeURIComponent(here)}`;
          return;
        }
        const { saved, error } = await toggleSaved(propertyId);
        if (!error) {
          setState(btn, saved);
          window.dispatchEvent(new CustomEvent('pghunter:saved', { detail: { propertyId, saved } }));
        }
      });
    }
  };

  void init();
</script>
