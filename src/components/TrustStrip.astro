---
import { Video, Mic, BadgeCheck, ShieldCheck } from '@lucide/astro';

const features = [
  {
    Icon: Video,
    title: 'Video Walkthroughs',
    body: 'See the room, washroom and building before you visit.',
  },
  {
    Icon: Mic,
    title: 'Owner Interviews',
    body: 'Real owners talk about the PG — rules, food and vibes.',
  },
  {
    Icon: BadgeCheck,
    title: 'Verified Listings',
    body: 'Listings carry their real verification status, nothing more.',
  },
  {
    Icon: ShieldCheck,
    title: 'Safety First',
    body: 'Area safety, girls PG zones and student-focused guidance.',
  },
];
---

<section aria-labelledby="trust-heading" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="border border-slate-200 bg-white">
    <h2 id="trust-heading" class="sr-only">Why use PG Hunter</h2>
    <ul class="grid grid-cols-1 gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">
      {features.map(({ Icon, title, body }, i) => (
        <li class="relative bg-white p-7 sm:p-8">
          {/* Stepped pixel tick in the corner of the first tile. */}
          {i === 0 && (
            <div class="pixel-rule absolute top-0 right-0" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i>
            </div>
          )}
          <span class="flex h-11 w-11 items-center justify-center bg-brand-100 text-brand-700">
            <Icon class="h-5 w-5" />
          </span>
          <h3 class="mt-5 text-base font-bold tracking-tight text-slate-900">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>