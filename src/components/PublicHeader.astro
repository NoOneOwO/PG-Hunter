---
import { Menu, X, UserRound, Bookmark, Compass, Wallet, LayoutDashboard } from '@lucide/astro';

interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;

// Role-aware public header:
// - Student: Explore / Saved / Earn with PG Hunter (no prominent For Owners)
// - Guest:   Explore / Saved / Earn + For Owners
// - Owner on public routes: Explore / Saved / Dashboard (Earn hidden), profile pill routes to /owner/profile
// Owner shell itself lives in OwnerHeader (/owner/*).
//
// There is deliberately no Profile *tab*: the account is reached through the
// avatar pill on the right, which is the one control that already knows whether
// a student or an owner is signed in. A second, redundant tab made the bar
// wider and gave two links the same destination.

const isActive = (href: string): boolean =>
  href === '/' ? activePath === '/' : activePath.startsWith(href);

const isExploreActive =
  activePath.startsWith('/pgs-near-you') ||
  activePath.startsWith('/pgs') ||
  activePath.startsWith('/colleges') ||
  activePath.startsWith('/localities');

/** Shared shape for a tab so the bar stays visually uniform. */
const tabBase =
  'relative inline-flex min-h-9 items-center gap-1.5 rounded-sm px-3 text-sm font-semibold transition-colors';
const tabActive = 'text-white';
const tabIdle = 'text-slate-600 hover:bg-white/70 hover:text-slate-900';

// Each entry drives one tab. `icon` is false for text-only labels so the bar
// keeps a consistent rhythm instead of a ragged one.
const tabs = [
  {
    key: 'explore',
    href: '/pgs-near-you',
    label: 'Explore',
    icon: Compass,
    active: isExploreActive,
  },
  {
    key: 'saved',
    href: '/saved',
    label: 'Saved',
    icon: Bookmark,
    active: isActive('/saved'),
  },
  {
    key: 'earn',
    href: '/earn',
    label: 'Earn with PG Hunter',
    icon: Wallet,
    active: isActive('/earn'),
    hiddenForOwner: true,
  },
  {
    key: 'for-owners',
    href: '/for-owners',
    label: 'For Owners',
    active: isActive('/for-owners'),
    guestOnly: true,
  },
  {
    key: 'dashboard',
    href: '/owner',
    label: 'Dashboard',
    icon: LayoutDashboard,
    active: isActive('/owner'),
    ownerOnly: true,
  },
];
---

<header
  id="site-header"
  data-appbar
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/85 backdrop-blur-md supports-[backdrop-filter]:bg-white/70"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex shrink-0 items-center gap-2" aria-label="PG Hunter home">
      <img
        src="/favicon.svg"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 transition-transform duration-200 group-hover:-rotate-6"
      />
      <span class="text-lg font-extrabold tracking-tight text-slate-900">
        PG<span class="text-brand-600">Hunter</span>
      </span>
    </a>

    <!-- Tab bar. The indicator is a single element that slides between tabs,
         so the active state reads as one continuous object rather than five
         independently tinted links. -->
    <div class="relative hidden min-w-0 flex-1 lg:block">
      <span
        data-tab-indicator
        aria-hidden="true"
        class="pointer-events-none absolute left-0 top-0 z-0 w-0 rounded-sm bg-brand-600"
        style="opacity:0"
      ></span>

      <nav
        id="primary-nav"
        data-tab-bar
        class="relative z-10 flex items-center gap-0.5 overflow-x-auto"
        aria-label="Primary"
      >
        {
          tabs.map((tab) => (
            <a
              data-nav={tab.key}
              href={tab.href}
              data-tab={tab.key}
              class:list={[
                tabBase,
                tab.active ? tabActive : tabIdle,
                tab.guestOnly && 'inline-flex',
                tab.ownerOnly && 'hidden',
              ]}
              aria-current={tab.active ? 'page' : undefined}
            >
              {tab.icon ? <tab.icon class="h-4 w-4 shrink-0" /> : null}
              <span class="whitespace-nowrap">{tab.label}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <div id="auth-guest" class="flex items-center gap-2">
        <a href="/login" class="btn-accent hidden sm:inline-flex" aria-label="Log in or sign up">
          Login/Sign up
        </a>
        <a
          href="/login"
          aria-label="Account"
          class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-slate-200 text-slate-700 transition-colors hover:bg-slate-50"
        >
          <UserRound class="h-5 w-5" />
        </a>
      </div>
      <div id="auth-user" class="hidden items-center gap-2">
        <a
          href="/profile"
          id="header-profile-link"
          class="hidden items-center gap-2 rounded-sm border border-slate-200 py-1 pl-1 pr-3 transition-colors hover:bg-slate-50 sm:inline-flex"
          aria-label="Your profile"
        >
          <span
            id="header-avatar"
            class="flex h-8 w-8 items-center justify-center rounded-sm bg-brand-600 text-xs font-extrabold text-white"
            >?</span
          >
          <span id="header-name" class="max-w-28 truncate text-sm font-semibold text-slate-800"
          ></span>
        </a>
        <a
          href="/profile"
          id="header-avatar-mobile"
          aria-label="Your profile"
          class="inline-flex h-11 w-11 items-center justify-center rounded-sm bg-brand-600 text-sm font-extrabold text-white sm:hidden"
          >?</a
        >
      </div>
      <button
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-sm text-slate-700 transition-colors hover:bg-slate-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Menu id="icon-open" class="h-5 w-5" />
        <X id="icon-close" class="hidden h-5 w-5" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-100 bg-white px-4 pb-4 pt-2 lg:hidden"
    aria-label="Mobile"
  >
    <div class="mx-auto flex max-w-7xl flex-col">
      {
        tabs.map((tab) => (
          <a
            data-nav={`${tab.key}-mobile`}
            href={tab.href}
            class:list={[
              'flex min-h-11 items-center gap-2 rounded-sm px-3 text-sm font-semibold',
              tab.active ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50',
              tab.ownerOnly && 'hidden',
            ]}
          >
            {tab.icon ? <tab.icon class="h-4 w-4" /> : null}
            {tab.label}
          </a>
        ))
      }
      <div id="auth-guest-mobile" class="mt-2">
        <a href="/login" class="btn-accent w-full sm:hidden">Login/Sign up</a>
      </div>
      <a href="/profile" id="auth-user-mobile" class="btn-secondary mt-2 hidden w-full sm:hidden">
        My profile
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconOpen = document.getElementById('icon-open') as HTMLElement;
  const iconClose = document.getElementById('icon-close') as HTMLElement;

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

  // ---- Tab indicator --------------------------------------------------
  // One element slides under whichever tab is current, so the bar reads as a
  // single object. Its resting state is set from the active tab's measured
  // box rather than from CSS, because the tabs are a variable set: the session
  // fetch hides Earn / For Owners / Dashboard depending on role, so the
  // correct width is not knowable until the DOM settles.

  import { animate } from 'motion';
  import { afterFirstLayout } from '@/lib/motion/ui';

  const bar = document.querySelector<HTMLElement>('[data-tab-bar]');
  const indicator = document.querySelector<HTMLElement>('[data-tab-indicator]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const SPRING = { type: 'spring', stiffness: 480, damping: 38, mass: 0.6 } as const;

  let placed = false;

  const placeIndicator = (animateMove = true) => {
    if (!bar || !indicator) return;
    // `:not(.hidden)` matters: hidden tabs are display:none and would
    // otherwise report a zero-width box and collapse the indicator.
    const current = bar.querySelector<HTMLElement>('[aria-current="page"]:not(.hidden)');
    if (!current) {
      indicator.style.opacity = '0';
      placed = false;
      return;
    }

    const left = current.offsetLeft;
    const width = current.offsetWidth;
    // Height/position are set directly rather than animated: every tab is the
    // same height, so there is nothing to spring between. Only the horizontal
    // travel ever changes, and that is the part worth animating.
    indicator.style.top = `${current.offsetTop}px`;
    indicator.style.height = `${current.offsetHeight}px`;

    if (animateMove && placed && !reduced) {
      animate(indicator, { x: left, width: `${width}px` }, SPRING);
      indicator.style.opacity = '1';
    } else {
      indicator.style.opacity = '1';
      indicator.style.transform = `translateX(${left}px)`;
      indicator.style.width = `${width}px`;
    }
    placed = true;
  };

  // Fonts swap and role-dependent tabs appear/disappear, both of which move the
  // tabs after first paint. Re-measure rather than trusting one measurement.
  afterFirstLayout(() => placeIndicator(false));
  document.fonts?.ready.then(() => placeIndicator(false));

  const barObserver = new ResizeObserver(() => placeIndicator(false));
  if (bar) barObserver.observe(bar);

  // ---- Role-aware navigation (student/owner/guest) --------------------
  // Visible nav is adapted client-side after session fetch; server render
  // is intentionally guest-friendly (For Owners visible, Dashboard hidden).
  import { getSession, onAuthChange, initialsOf } from '@/lib/auth';
  import type { AppUser } from '@/lib/auth';

  const guest = document.getElementById('auth-guest')!;
  const userWrap = document.getElementById('auth-user')!;
  const guestMobile = document.getElementById('auth-guest-mobile')!;
  const userMobile = document.getElementById('auth-user-mobile')!;
  const avatar = document.getElementById('header-avatar')!;
  const avatarMobile = document.getElementById('header-avatar-mobile')!;
  const nameEl = document.getElementById('header-name')!;
  const headerProfileLink = document.getElementById('header-profile-link') as HTMLAnchorElement | null;
  const headerAvatarMobile = document.getElementById('header-avatar-mobile') as HTMLAnchorElement | null;

  const navForOwners = document.querySelector<HTMLElement>('[data-nav="for-owners"]');
  const navDashboard = document.querySelector<HTMLElement>('[data-nav="dashboard"]');
  const navEarn = document.querySelector<HTMLElement>('[data-nav="earn"]');
  const navForOwnersMobile = document.querySelector<HTMLElement>('[data-nav="for-owners-mobile"]');
  const navDashboardMobile = document.querySelector<HTMLElement>('[data-nav="dashboard-mobile"]');
  const navEarnMobile = document.querySelector<HTMLElement>('[data-nav="earn-mobile"]');

  const showFlex = (el: HTMLElement | null, show: boolean) => {
    if (!el) return;
    el.classList.toggle('hidden', !show);
    el.classList.toggle('inline-flex', show);
    el.classList.toggle('flex', false);
  };
  const showFlexMobile = (el: HTMLElement | null, show: boolean) => {
    if (!el) return;
    el.classList.toggle('hidden', !show);
    if (show) el.classList.add('flex');
  };

  const renderAuth = (user: AppUser | null) => {
    const loggedIn = Boolean(user);
    const isOwner = user?.role === 'owner' || Boolean(user?.isAdmin);

    guest.classList.toggle('hidden', loggedIn);
    guest.classList.toggle('flex', !loggedIn);
    userWrap.classList.toggle('hidden', !loggedIn);
    userWrap.classList.toggle('flex', loggedIn);
    guestMobile.classList.toggle('hidden', loggedIn);
    userMobile.classList.toggle('hidden', !loggedIn);

    // Nav items:
    // - Student: Explore / Saved / Earn (For Owners hidden)
    // - Guest:   Explore / Saved / Earn / For Owners
    // - Owner:   Explore / Saved / Dashboard (Earn hidden), pill goes to /owner/profile
    showFlex(navForOwners, !loggedIn);
    showFlex(navDashboard, isOwner);
    showFlex(navEarn, !isOwner);
    showFlexMobile(navForOwnersMobile, !loggedIn);
    showFlexMobile(navDashboardMobile, isOwner);
    showFlexMobile(navEarnMobile, !isOwner);

    // The tab set just changed shape, so the indicator's resting box moved.
    placeIndicator();

    // Profile pill destination: owners go to their shell, students to /profile
    if (headerProfileLink) headerProfileLink.href = isOwner ? '/owner/profile' : '/profile';
    if (headerAvatarMobile) headerAvatarMobile.href = isOwner ? '/owner/profile' : '/profile';
    const authUserMobile = document.getElementById('auth-user-mobile') as HTMLAnchorElement | null;
    if (authUserMobile) authUserMobile.href = isOwner ? '/owner/profile' : '/profile';

    if (user) {
      const initials = initialsOf(user.name);
      avatar.textContent = initials;
      avatarMobile.textContent = initials;
      nameEl.textContent = user.name.split(' ')[0];
    }
  };

  getSession().then(renderAuth);
  onAuthChange(renderAuth);
</script>