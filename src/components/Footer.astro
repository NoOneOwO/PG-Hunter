---
import LogoBadge from '@/components/LogoBadge.astro';
import { MapPin, Phone, Mail } from '@lucide/astro';

const year = new Date().getFullYear();

const discover = [
  { href: '/pgs-near-you', label: 'PGs Near You' },
  { href: '/colleges', label: 'Colleges' },
  { href: '/colleges/dtu', label: 'PGs near DTU' },
  { href: '/colleges/nsut', label: 'PGs near NSUT' },
  { href: '/localities', label: 'Localities' },
];

const owners = [
  { href: '/for-owners', label: 'List your PG' },
  { href: '/for-owners', label: 'Owner login' },
  { href: '/for-owners#verification', label: 'Verification' },
  { href: '/earn', label: 'Earn with PG Hunter' },
];
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <LogoBadge class="h-8 w-8" />
          <span class="text-lg font-extrabold tracking-tight text-slate-900">
            PG<span class="text-brand-600">Hunter</span>
          </span>
        </a>

        <p class="pixel-rule mt-5" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </p>

        <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-600">
          Student-first accommodation discovery. Find PGs, rooms, hostels and co-living
          spaces near your college — with video walkthroughs, transparent pricing and
          no broker, no hidden charges.
        </p>

        <ul class="mt-6 flex flex-col gap-2.5 text-sm text-slate-600">
          <li class="flex items-center gap-2"><MapPin class="h-4 w-4 text-brand-600" /> New Delhi, India</li>
          <li class="flex items-center gap-2"><Mail class="h-4 w-4 text-brand-600" /> hello@pghunter.in</li>
          <li class="flex items-center gap-2"><Phone class="h-4 w-4 text-brand-600" /> +91 98XXX XXXXX (not live)</li>
        </ul>
      </div>

      <nav aria-label="Discover">
        <h2 class="text-xs font-bold tracking-[0.18em] text-slate-900 uppercase">Discover</h2>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {discover.map((item) => (
            <li>
              <a
                href={item.href}
                class="border-l-2 border-transparent pl-3 text-slate-600 transition-colors hover:border-brand-500 hover:text-brand-700"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="For Owners">
        <h2 class="text-xs font-bold tracking-[0.18em] text-slate-900 uppercase">For Owners</h2>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {owners.map((item) => (
            <li>
              <a
                href={item.href}
                class="border-l-2 border-transparent pl-3 text-slate-600 transition-colors hover:border-brand-500 hover:text-brand-700"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <p id="footer-owner-cta" class="card pixel-corner relative mt-6 px-4 py-3.5 text-xs leading-relaxed text-slate-700">
          Own a PG? <a href="/for-owners" class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-800">List it on PG Hunter</a> — reach verified students near your property.
        </p>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} PG Hunter. All rights reserved.</p>
      <p class="badge w-fit border border-brand-200 bg-brand-50 text-brand-700">
        Every PG here is published by its owner — no samples, no brokers.
      </p>
    </div>
  </div>
</footer>

<script>
  // Subtle CTA visibility: hide for owners (they already list), show for students/guests.
  import { getSession } from '@/lib/auth';
  const cta = document.getElementById('footer-owner-cta');
  if (cta) {
    getSession().then((u) => {
      if (u?.role === 'owner' || u?.isAdmin) cta.classList.add('hidden');
    });
  }
</script>