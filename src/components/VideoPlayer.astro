---
import { Play, ExternalLink } from '@lucide/astro';
import { youTubeId } from '@/lib/html';

interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;
// The id is interpolated into a thumbnail URL, an embed URL and a watch link.
// A stored value that is not a plausible id would otherwise be able to inject
// path or query content into all three, so validate before any of them.
const safeId = youTubeId(videoId);
const thumb = safeId ? `https://i.ytimg.com/vi/${safeId}/hqdefault.jpg` : '';
---

{safeId ? (

<div class="video-player relative aspect-video w-full overflow-hidden rounded-2xl bg-slate-900">
  <img
    src={thumb}
    alt={title}
    loading="lazy"
    decoding="async"
    width="480"
    height="360"
    class="h-full w-full object-cover opacity-90"
  />
  <button
    type="button"
    class="absolute inset-0 flex items-center justify-center"
    data-video-open
    data-video-id={safeId}
    aria-label={`Play video: ${title}`}
  >
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/95 text-brand-700 shadow-popover transition-transform hover:scale-105">
      <Play class="h-7 w-7 fill-current" />
    </span>
  </button>
  <a
    href={`https://www.youtube.com/watch?v=${safeId}`}
    target="_blank"
    rel="noopener"
    class="absolute bottom-3 right-3 inline-flex items-center gap-1 rounded-full bg-slate-900/70 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur"
  >
    Watch on YouTube
    <ExternalLink class="h-3 w-3" />
  </a>
</div>
) : (
  <div class="flex aspect-video w-full items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-sm font-medium text-slate-500">
    Walkthrough video unavailable
  </div>
)}

<script>
  const players = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-video-open]'));

  players.forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.videoId;
      const container = button.parentElement;
      // Re-validate client-side rather than trusting the rendered attribute.
      if (!id || !/^[A-Za-z0-9_-]{6,32}$/.test(id) || !container) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = 'Video walkthrough';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      container.innerHTML = '';
      container.appendChild(iframe);
    });
  });
</script>
