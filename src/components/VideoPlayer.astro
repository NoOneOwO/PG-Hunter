---
import { Play, ExternalLink } from '@lucide/astro';

interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="video-player relative aspect-video w-full overflow-hidden rounded-2xl bg-slate-900">
  <img
    src={thumb}
    alt={title}
    loading="lazy"
    decoding="async"
    width="480"
    height="360"
    class="h-full w-full object-cover opacity-90"
  />
  <button
    type="button"
    class="absolute inset-0 flex items-center justify-center"
    data-video-open
    data-video-id={videoId}
    aria-label={`Play video: ${title}`}
  >
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/95 text-brand-700 shadow-popover transition-transform hover:scale-105">
      <Play class="h-7 w-7 fill-current" />
    </span>
  </button>
  <a
    href={`https://www.youtube.com/watch?v=${videoId}`}
    target="_blank"
    rel="noopener"
    class="absolute bottom-3 right-3 inline-flex items-center gap-1 rounded-full bg-slate-900/70 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur"
  >
    Watch on YouTube
    <ExternalLink class="h-3 w-3" />
  </a>
</div>

<script>
  const players = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-video-open]'));

  players.forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.videoId;
      const container = button.parentElement;
      if (!id || !container) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = 'Video walkthrough';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      container.innerHTML = '';
      container.appendChild(iframe);
    });
  });
</script>
