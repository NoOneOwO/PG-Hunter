---
import LogoBadge from '@/components/LogoBadge.astro';
import { LayoutDashboard, Building2, Inbox, MessageSquare, BadgeCheck, Wallet, UserRound, LogOut, ExternalLink, Menu, X } from '@lucide/astro';

interface Props {
  /** Slug of the active nav item. */
  active?: 'dashboard' | 'listings' | 'leads' | 'messages' | 'verification' | 'plans' | 'profile';
}

const { active = 'dashboard' } = Astro.props;

// The owner navbar is used only on /owner/* routes (via OwnerLayout).
// Public routes always use PublicHeader, so these two navigation sets never mix.
const navItems = [
  { key: 'dashboard', label: 'Dashboard', href: '/owner', Icon: LayoutDashboard },
  { key: 'listings', label: 'My PGs', href: '/owner/listings', Icon: Building2 },
  { key: 'leads', label: 'Enquiries', href: '/owner/leads', Icon: Inbox },
  { key: 'messages', label: 'Messages', href: '/owner/messages', Icon: MessageSquare },
  { key: 'verification', label: 'Verification', href: '/owner/verification', Icon: BadgeCheck },
  { key: 'plans', label: 'Plans', href: '/owner/plans', Icon: Wallet },
  { key: 'profile', label: 'Profile', href: '/owner/profile', Icon: UserRound },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/owner" class="flex items-center gap-2" aria-label="PG Hunter owner dashboard">
      <LogoBadge class="h-8 w-8" />
      <span class="text-lg font-extrabold tracking-tight text-slate-900">
        PG<span class="text-brand-600">Hunter</span>
        <span class="ml-1 rounded-md bg-brand-50 px-1.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-brand-700">
          Owner
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Owner">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'inline-flex min-h-11 items-center gap-1.5 rounded-sm px-3 text-sm font-semibold transition-colors',
            active === item.key
              ? 'bg-brand-50 text-brand-700'
              : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
          ]}
          aria-current={active === item.key ? 'page' : undefined}
        >
          <item.Icon class="h-4 w-4" />
          {item.label}
        </a>
      ))}
      <button
        type="button"
        data-logout
        class="inline-flex min-h-11 items-center gap-1.5 rounded-sm px-3 text-sm font-semibold text-slate-600 transition-colors hover:bg-rose-50 hover:text-rose-600"
      >
        <LogOut class="h-4 w-4" /> Log out
      </button>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="/"
        title="View public site"
        class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-slate-200 text-slate-600 transition-colors hover:bg-slate-50"
        aria-label="View public site"
      >
        <ExternalLink class="h-5 w-5" />
      </a>
      <a
        href="/owner/profile"
        class="inline-flex h-11 items-center gap-2 rounded-sm border border-slate-200 py-1 pl-1 pr-3 transition-colors hover:bg-slate-50"
        aria-label="Your profile"
      >
        <span class="relative flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-sm bg-brand-600 text-xs font-extrabold text-white">
          <img id="owner-avatar-img" alt="" class="absolute inset-0 hidden h-full w-full object-cover" referrerpolicy="no-referrer" />
          <span id="owner-avatar">?</span>
        </span>
        <span id="owner-name" class="hidden max-w-28 truncate text-sm font-semibold text-slate-800 sm:block"></span>
      </a>
      <button
        id="owner-menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-sm text-slate-700 transition-colors hover:bg-slate-50 lg:hidden"
        aria-expanded="false"
        aria-controls="owner-mobile-menu"
        aria-label="Open menu"
      >
        <Menu id="owner-icon-open" class="h-5 w-5" />
        <X id="owner-icon-close" class="hidden h-5 w-5" />
      </button>
    </div>
  </div>

  <nav
    id="owner-mobile-menu"
    class="hidden border-t border-slate-100 bg-white px-4 pb-4 pt-2 lg:hidden"
    aria-label="Owner mobile"
  >
    <div class="mx-auto flex max-w-7xl flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex min-h-11 items-center gap-2 rounded-sm px-3 text-sm font-semibold',
            active === item.key ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50',
          ]}
        >
          <item.Icon class="h-4 w-4" />
          {item.label}
        </a>
      ))}
      <button
        type="button"
        data-logout
        class="flex min-h-11 items-center gap-2 rounded-sm px-3 text-sm font-semibold text-rose-600 transition-colors hover:bg-rose-50"
      >
        <LogOut class="h-4 w-4" /> Log out
      </button>
      <a href="/" class="mt-1 flex min-h-11 items-center gap-2 rounded-sm px-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">
        <ExternalLink class="h-4 w-4" /> View public site
      </a>
    </div>
  </nav>
</header>

<script>
  import { getSession, onAuthChange, signOut, initialsOf } from '@/lib/auth';
  import type { AppUser } from '@/lib/auth';

  const avatar = document.getElementById('owner-avatar')!;
  const avatarImg = document.getElementById('owner-avatar-img') as HTMLImageElement | null;
  const nameEl = document.getElementById('owner-name')!;
  const menuToggle = document.getElementById('owner-menu-toggle') as HTMLButtonElement;
  const mobileMenu = document.getElementById('owner-mobile-menu') as HTMLElement;
  const iconOpen = document.getElementById('owner-icon-open') as HTMLElement;
  const iconClose = document.getElementById('owner-icon-close') as HTMLElement;

  menuToggle.addEventListener('click', () => {
    const open = mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('[data-logout]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await signOut();
      window.location.href = '/';
    });
  });

  const paintAvatar = (user: AppUser | null) => {
    if (!user) return;
    avatar.textContent = initialsOf(user.name);
    nameEl.textContent = user.name.split(' ')[0];

    // Photo when there is one, initials otherwise. Hidden until it loads so a
    // missing picture never flashes a broken-image icon in the nav — and
    // toggled as a CLASS, because `.hidden` lives in the class attribute while
    // `img.hidden` is a separate property. Setting the property left the class
    // in place, so an uploaded photo never showed up here.
    const src = user.avatar ?? '';
    if (!avatarImg) return;
    if (!src) {
      avatarImg.classList.add('hidden');
      avatarImg.removeAttribute('src');
      return;
    }
    avatarImg.classList.add('hidden');
    avatarImg.onload = () => {
      avatarImg.classList.remove('hidden');
    };
    avatarImg.onerror = () => {
      avatarImg.classList.add('hidden');
    };
    avatarImg.src = src;
  };

  // Paint on load, and again whenever the session changes — uploading a photo
  // on /owner/profile emits an auth change, so the pill updates immediately
  // instead of waiting for the next full page load.
  getSession().then(paintAvatar);
  onAuthChange(paintAvatar);
</script>