---
/**
 * Admin notification bell.
 *
 * Items are derived server-side from real queue rows (see server/adminInbox.ts).
 * This component is presentation only: a count badge and a dropdown. Opening it
 * marks the inbox seen via POST /api/admin/inbox/seen so the count is truthful
 * rather than cleared optimistically.
 *
 * Included twice (desktop top bar + mobile header), so all markup is keyed by
 * `data-*` attributes rather than ids.
 */
import { Bell, Check } from '@lucide/astro';
import type { AdminInboxItem } from '@/lib/adminInbox';

interface Props {
  unread: number;
  items: AdminInboxItem[];
}

const { unread, items } = Astro.props;
const hasUnread = unread > 0;
---

<div class="relative" data-notif>
  <button
    type="button"
    data-notif-toggle
    class="relative inline-flex h-10 w-10 items-center justify-center rounded-sm border border-slate-200 bg-white text-slate-600 transition-colors hover:border-brand-300 hover:text-brand-700"
    aria-label={hasUnread ? `Notifications, ${unread} unread` : 'Notifications'}
    aria-haspopup="true"
    aria-expanded="false"
  >
    <Bell class="h-4 w-4" />
    <span
      data-notif-count
      class:list={[
        'absolute -right-1.5 -top-1.5 min-w-5 items-center justify-center rounded-full bg-rose-600 px-1 text-[10px] font-bold leading-5 text-white',
        hasUnread ? 'flex' : 'hidden',
      ]}
    >
      {unread > 99 ? '99+' : unread}
    </span>
  </button>

  <div
    data-notif-panel
    class="absolute right-0 z-40 mt-2 hidden w-80 max-w-[calc(100vw-2rem)] overflow-hidden rounded-sm border border-slate-200 bg-white shadow-xl"
    role="menu"
    aria-label="Notifications"
  >
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
      <p class="text-sm font-bold text-slate-900">Notifications</p>
      <a href="/admin#attention" class="text-xs font-semibold text-brand-700 hover:underline">
        View queues
      </a>
    </div>

    <div class="max-h-96 overflow-y-auto">
      {
        items.length === 0 ? (
          <div class="flex flex-col items-center gap-1 px-4 py-10 text-center">
            <Check class="h-5 w-5 text-emerald-600" />
            <p class="text-sm font-semibold text-slate-700">You're all caught up</p>
            <p class="text-xs text-slate-500">New submissions will appear here.</p>
          </div>
        ) : (
          items.map((item) => (
            <a
              href={item.href}
              class="flex items-start gap-3 border-b border-slate-100 px-4 py-3 transition-colors last:border-0 hover:bg-slate-50"
              role="menuitem"
            >
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold text-slate-800">{item.title}</span>
                <span class="mt-0.5 block truncate text-xs text-slate-500">{item.detail}</span>
              </span>
            </a>
          ))
        )
      }
    </div>
  </div>
</div>

<script>
  const markSeen = async () => {
    try {
      await fetch('/api/admin/inbox/seen', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
      });
    } catch {
      // Clearing the badge optimistically is worse than leaving it; keep it.
    }
  };

  document.querySelectorAll<HTMLElement>('[data-notif]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-notif-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-notif-panel]');
    const count = root.querySelector<HTMLElement>('[data-notif-count]');
    if (!toggle || !panel) return;

    const close = () => {
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      // Only clear after the server confirms the watermark moved.
      void markSeen().then(() => {
        if (count) {
          count.classList.add('hidden');
          count.classList.remove('flex');
          count.textContent = '0';
        }
        toggle.setAttribute('aria-label', 'Notifications');
      });
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      if (panel.classList.contains('hidden')) open();
      else close();
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
